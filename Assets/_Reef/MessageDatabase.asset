  m_Script: {fileID: 11500000, guid: d8508b20be1c4604dad771cb6e5fefb7, type: 3}
  m_Name: MessageDatabase
  m_EditorClassIdentifier: Assembly-CSharp::_Abdullah.MessageDatabase
  messages:
  - sender: aramex.delivery.hub@yahoo.com
    subject: "\u062A\u062D\u062F\u064A\u062B \u0622\u0631\u0627\u0645\u0643\u0633:
      \u062A\u0639\u0630\u0631 \u062A\u0633\u0644\u064A\u0645 \u0637\u0631\u062F\u0643
      \u0627\u0644\u0628\u0631\u064A\u062F\u064A"
    content: "[\uFEC2\uFE91\u0627\uFEAE\uFEDF\u0627 \uFEC2\uFED0\uFEBF\u0627] :\uFEF2\uFEDF\uFE8E\uFE98\uFEDF\u0627
      \uFEC2\uFE91\u0627\uFEAE\uFEDF\u0627 \uFEAE\uFE92\uFECB \uFEDA\uFED4\uFE97\uFE8E\uFEEB
      \uFEE2\uFED7\u0631 \uFEAA\uFEF4\uFEDB\uFE84\uFE97\u0648 \uFEDE\uFEF4\uFEBB\uFEEE\uFE98\uFEDF\u0627
      \uFEAA\uFECB\uFEEE\uFEE3 \uFE94\uFEDF\u0648\uFEAA\uFE9F \u0629\u062F\uFE8E\uFECB\u0625
      \uFBFD\uFE9F\uFEAE\uFEF3 .\uFE94\uFE91\uFE8E\uFEA0\uFE98\uFEB3\u0627 \u064A\u0623
      \uFEAA\uFEA0\uFEE7 \uFEE2\uFEDF \uFEE6\uFEDC\uFEDF\u0648 \u0645\uFEEE\uFEF4\uFEDF\u0627
      \u0643\u062F\uFEAE\uFEC3 \uFEE2\uFEF4\uFEE0\uFEB4\uFE97 \uFE8E\uFEE8\uFEDF\u0648\uFE8E\uFEA3
      \u060C\u064B\uFE8E\uFE92\uFEA3\uFEAE\uFEE3"
    isScam: 1
    explanation: "\u0634\u0631\u0643\u0629 \u0622\u0631\u0627\u0645\u0643\u0633 \u0627\u0644\u0644\u0648\u062C\u0633\u062A\u064A\u0629
      \u0627\u0644\u0639\u0627\u0644\u0645\u064A\u0629 \u062A\u0645\u062A\u0644\u0643
      \u0633\u064A\u0631\u0641\u0631\u0627\u062A \u0645\u062E\u0635\u0635\u0629 \u0648\u0646\u0637\u0627\u0642\u0627\u064B
      \u062E\u0627\u0635\u0627\u064B \u0628\u0647\u0627 \u0648\u0644\u0627 \u062A\u0633\u062A\u062E\u062F\u0645
      \u0628\u0631\u064A\u062F \u064A\u0627\u0647\u0648."
    messageType: 0
  - sender: smsa-care-delivery@outlook.com
    subject: "\u0633\u0645\u0633\u0627 \u0625\u0643\u0633\u0628\u0631\u064A\u0633:
      \u0641\u0634\u0644 \u062A\u0648\u0635\u064A\u0644 \u0627\u0644\u0637\u0631\u062F
      \u0628\u0633\u0628\u0628 \u062E\u0637\u0623 \u0641\u064A \u0645\u0648\u0642\u0639
      \u0627\u0644\u0645\u0646\u0632\u0644"
    content: "\u0639\u0645\u064A\u0644\u0646\u0627 \u0627\u0644\u0639\u0632\u064A\u0632\u060C
      \u0634\u062D\u0646\u062A\u0643 \u0642\u064A\u062F \u0627\u0644\u0627\u0646\u062A\u0638\u0627\u0631
      \u0641\u064A \u0641\u0631\u0639 \u0627\u0644\u0641\u0631\u0632 \u0627\u0644\u0631\u0626\u064A\u0633\u064A.
      \u064A\u0631\u062C\u0649 \u062A\u062D\u062F\u064A\u062B \u0625\u062D\u062F\u0627\u062B\u064A\u0627\u062A
      \u0645\u0648\u0642\u0639\u0643 \u0639\u0628\u0631 \u0646\u0638\u0627\u0645
      \u0627\u0644\u062E\u0631\u0627\u0626\u0637 \u0627\u0644\u0645\u0631\u0641\u0642
      \u0648\u062F\u0641\u0639 5 \u0631\u064A\u0627\u0644\u0627\u062A \u0631\u0633\u0648\u0645
      \u0625\u0639\u0627\u062F\u0629 \u062A\u0648\u062C\u064A\u0647: [\u0627\u0636\u063A\u0637
      \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u064A\u0637\u0644\u0628 \u0627\u0644\u0645\u062D\u062A\u0627\u0644
      \u0645\u0628\u0644\u063A\u0627\u064B \u0635\u063A\u064A\u0631\u0627\u064B \u062C\u062F\u0627\u064B
      (5 \u0631\u064A\u0627\u0644\u0627\u062A) \u0644\u0643\u064A \u0644\u0627 \u062A\u062A\u0631\u062F\u062F
      \u0641\u064A \u062F\u0641\u0639\u0647\u060C \u0648\u0644\u0643\u0646 \u0647\u062F\u0641\u0647
      \u0627\u0644\u062D\u0642\u064A\u0642\u064A \u0647\u0648 \u0633\u0631\u0642\u0629
      \u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0627\u0626\u062A\u0645\u0627\u0646\u064A\u0629
      \u0627\u0644\u062A\u064A \u0633\u062A\u062F\u062E\u0644\u0647\u0627 \u0641\u064A
      \u0635\u0641\u062D\u0629 \u0627\u0644\u062F\u0641\u0639 \u0627\u0644\u0645\u0632\u064A\u0641\u0629.\u060C
      \u0648\u0627\u0644\u0645\u0631\u0633\u0644 \u062D\u0633\u0627\u0628 \u0623\u0648\u062A\u0644\u0648\u0643
      \u0645\u062C\u0627\u0646\u064A \u0645\u0646\u062A\u062D\u0644 \u0644\u0634\u0631\u0643\u0629
      \u0633\u0645\u0633\u0627 \u0627\u0644\u0645\u062D\u0644\u064A\u0629."
    messageType: 0
  - sender: gosi.insurance-update@gmail.com
    subject: "\u0627\u0644\u062A\u0623\u0645\u064A\u0646\u0627\u062A \u0627\u0644\u0627\u062C\u062A\u0645\u0627\u0639\u064A\u0629:
      \u062A\u0639\u062F\u064A\u0644 \u0633\u0644\u0645 \u0627\u0644\u0631\u0648\u0627\u062A\u0628
      \u0648\u0627\u062D\u062A\u0633\u0627\u0628 \u0645\u0633\u062A\u062D\u0642\u0627\u062A
      \u062C\u062F\u064A\u062F\u0629"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u0628\u0643\u060C \u0623\u0639\u0644\u0646\u062A
      \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0639\u0627\u0645\u0629
      \u0644\u0644\u062A\u0623\u0645\u064A\u0646\u0627\u062A \u0627\u0644\u0627\u062C\u062A\u0645\u0627\u0639\u064A\u0629
      \u0639\u0646 \u062A\u062D\u062F\u064A\u062B\u0627\u062A \u062C\u062F\u064A\u062F\u0629
      \u0641\u064A \u0646\u0638\u0627\u0645 \u0627\u0644\u062A\u0642\u0627\u0639\u062F
      \u0648\u0635\u0631\u0641 \u0627\u0644\u062A\u0639\u0648\u064A\u0636\u0627\u062A.
      \u0644\u0644\u062A\u062D\u0642\u0642 \u0645\u0646 \u0623\u0647\u0644\u064A\u062A\u0643
      \u0648\u0642\u064A\u0645\u0629 \u062F\u0639\u0645\u0643 \u0627\u0636\u063A\u0637
      \u0647\u0646\u0627: [\u0627\u0636\u063A\u0637 \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0645\u0624\u0633\u0633\u0629 \u062D\u0643\u0648\u0645\u064A\u0629
      \u0636\u062E\u0645\u0629 \u0643\u0627\u0644\u062A\u0623\u0645\u064A\u0646\u0627\u062A
      \u0644\u0627 \u062A\u0639\u0644\u0646 \u0639\u0646 \u0642\u0631\u0627\u0631\u0627\u062A
      \u0633\u064A\u0627\u062F\u064A\u0629 \u0623\u0648 \u062A\u0641\u062D\u0635
      \u0627\u0644\u0623\u0647\u0644\u064A\u0629 \u0627\u0644\u0645\u0627\u062F\u064A\u0629
      \u0639\u0628\u0631 \u062D\u0633\u0627\u0628 \u062C\u064A \u0645\u064A\u0644
      \u0639\u0627\u0645."
    messageType: 0
  - sender: instagram-blue-badge-verify@gmail.com
    subject: "\u0627\u0646\u0633\u062A\u063A\u0631\u0627\u0645: \u0642\u062F\u0651\u0645
      \u0637\u0644\u0628\u0627\u064B \u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649
      \u0634\u0627\u0631\u0629 \u0627\u0644\u062A\u0648\u062B\u064A\u0642 \u0627\u0644\u0632\u0631\u0642\u0627\u0621
      \u0627\u0644\u0631\u0633\u0645\u064A\u0629 \u0627\u0644\u064A\u0648\u0645"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B\u060C \u0642\u0627\u0645 \u0646\u0638\u0627\u0645\u0646\u0627
      \u0628\u0645\u0631\u0627\u062C\u0639\u0629 \u0645\u0644\u0641\u0643 \u0627\u0644\u0634\u062E\u0635\u064A
      \u0648\u062A\u0628\u064A\u0646 \u0623\u0646\u0643 \u0645\u0624\u0647\u0644
      \u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649 \u0634\u0627\u0631\u0629
      \u0627\u0644\u062A\u0648\u062B\u064A\u0642 \u0645\u062C\u0627\u0646\u0627\u064B.
      \u0644\u0644\u0645\u0637\u0627\u0644\u0628\u0629 \u0628\u0634\u0627\u0631\u062A\u0643\u060C
      \u0633\u062C\u0644 \u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649
      \u062D\u0633\u0627\u0628 \u0645\u064A\u062A\u0629 \u0627\u0644\u062E\u0627\u0635
      \u0628\u0643 \u0647\u0646\u0627: [\u0627\u0646\u0642\u0631 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0634\u0631\u0643\u0629 \u0627\u0646\u0633\u062A\u063A\u0631\u0627\u0645
      \u0623\u0648 Meta \u0644\u0627 \u062A\u0645\u0646\u062D \u0634\u0627\u0631\u0627\u062A
      \u0627\u0644\u062A\u0648\u062B\u064A\u0642 \u0627\u0644\u0632\u0631\u0642\u0627\u0621
      \u0639\u0628\u0631 \u0631\u0648\u0627\u0628\u0637 \u062A\u0633\u062C\u064A\u0644
      \u062F\u062E\u0648\u0644 \u062E\u0627\u0631\u062C\u064A\u0629 \u0645\u0631\u0633\u0644\u0629
      \u0645\u0646 \u062D\u0633\u0627\u0628\u0627\u062A \u062C\u064A\u0645\u064A\u0644
      \u0645\u062C\u0627\u0646\u064A\u0629."
    messageType: 0
  - sender: netflix-billing-support@gmail.com
    subject: "\u0639\u0636\u0648\u064A\u0629 Netflix \u0627\u0644\u062E\u0627\u0635\u0629
      \u0628\u0643 \u0645\u0639\u0644\u0642\u0629: \u064A\u0631\u062C\u0649 \u062A\u062D\u062F\u064A\u062B
      \u0637\u0631\u064A\u0642\u0629 \u0627\u0644\u062F\u0641\u0639"
    content: "\u0644\u0645 \u0646\u062A\u0645\u0643\u0646 \u0645\u0646 \u0645\u0639\u0627\u0644\u062C\u0629
      \u0631\u0633\u0648\u0645 \u0627\u0634\u062A\u0631\u0627\u0643\u0643 \u0627\u0644\u0634\u0647\u0631\u064A.
      \u064A\u0631\u062C\u0649 \u0627\u0644\u0636\u063A\u0637 \u0647\u0646\u0627
      \u0644\u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u062D\u0633\u0627\u0628\u0643
      \u0648\u062A\u062D\u062F\u064A\u062B \u062A\u0641\u0627\u0635\u064A\u0644 \u0628\u0637\u0627\u0642\u0629
      Visa \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0643 \u0642\u0628\u0644 \u062D\u0630\u0641
      \u0645\u0644\u0641\u0643 \u0627\u0644\u0634\u062E\u0635\u064A: [\u0627\u0646\u0642\u0631
      \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0634\u0631\u0643\u0629 Netflix \u0644\u0627 \u062A\u0633\u062A\u062E\u062F\u0645
      \u062D\u0633\u0627\u0628\u0627\u062A \u062C\u064A\u0645\u064A\u0644 \u0645\u062C\u0627\u0646\u064A\u0629
      \u0639\u0634\u0648\u0627\u0626\u064A\u0629.\u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629
      \u0625\u0644\u0649 \u0637\u0644\u0628 \u062A\u062D\u062F\u064A\u062B \u0628\u064A\u0627\u0646\u0627\u062A
      \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0639\u0628\u0631 \u0631\u0627\u0628\u0637
      \u0645\u0639 \u0627\u0644\u062A\u0647\u062F\u064A\u062F \u0628\u062A\u0639\u0644\u064A\u0642
      \u0627\u0644\u062D\u0633\u0627\u0628\u060C \u0648\u0647\u064A \u0645\u0624\u0634\u0631\u0627\u062A
      \u0648\u0627\u0636\u062D\u0629 \u0639\u0644\u0649 \u0631\u0633\u0627\u0644\u0629
      \u062A\u0635\u064A\u062F."
    messageType: 0
  - sender: paypal-billing-department@outlook.com
    subject: "\u0625\u0634\u0639\u0627\u0631: \u062A\u0645 \u062A\u0642\u064A\u064A\u062F
      \u062D\u0633\u0627\u0628 PayPal \u0627\u0644\u062E\u0627\u0635 \u0628\u0643"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u0631\u0635\u062F\u0646\u0627 \u0646\u0634\u0627\u0637\u0627\u064B \u063A\u064A\u0631
      \u0645\u0639\u062A\u0627\u062F \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u062A\u0643
      \u0627\u0644\u0627\u0626\u062A\u0645\u0627\u0646\u064A\u0629 \u0627\u0644\u0645\u0631\u062A\u0628\u0637\u0629
      \u0628\u062D\u0633\u0627\u0628 PayPal. \u0644\u0631\u0641\u0639 \u0647\u0630\u0627
      \u0627\u0644\u062A\u0642\u064A\u064A\u062F\u060C \u064A\u0631\u062C\u0649 \u062A\u0623\u0643\u064A\u062F
      \u0647\u0648\u064A\u062A\u0643 \u0639\u0628\u0631 \u0631\u0641\u0639 \u0646\u0633\u062E\u0629
      \u0645\u0646 \u0628\u0637\u0627\u0642\u062A\u0643 \u0627\u0644\u0634\u062E\u0635\u064A\u0629
      \u0647\u0646\u0627: [\u0627\u0636\u063A\u0637 \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u062A\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u0631\u0633\u0627\u0644\u0629
      \u0628\u0631\u064A\u062F\u064B\u0627 \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u064B\u0627
      \u063A\u064A\u0631 \u0631\u0633\u0645\u064A\u060C \u0648\u062A\u0637\u0644\u0628
      \u0631\u0641\u0639 \u0646\u0633\u062E\u0629 \u0645\u0646 \u0627\u0644\u0647\u0648\u064A\u0629
      \u0639\u0628\u0631 \u0631\u0627\u0628\u0637\u060C \u0648\u0647\u0645\u0627
      \u0645\u0624\u0634\u0631\u0627\u0646 \u0648\u0627\u0636\u062D\u0627\u0646 \u0639\u0644\u0649
      \u0645\u062D\u0627\u0648\u0644\u0629 \u062A\u0635\u064A\u062F \u0627\u062D\u062A\u064A\u0627\u0644\u064A."
    messageType: 0
  - sender: noon-offers-anniversary@gmail.com
    subject: "\U0001F389 \u0645\u0628\u0631\u0648\u0643! \u0644\u0642\u062F \u0631\u0628\u062D\u062A
      \u0642\u0633\u064A\u0645\u0629 \u0645\u0634\u062A\u0631\u064A\u0627\u062A \u0645\u062C\u0627\u0646\u064A\u0629
      \u0628\u0642\u064A\u0645\u0629 1500 \u0631\u064A\u0627\u0644 \u0645\u0646 \u0646\u0648\u0646"
    content: "\u0639\u0645\u064A\u0644\u0646\u0627 \u0627\u0644\u0645\u062D\u0638\u0648\u0638\u060C
      \u062A\u0645 \u0627\u062E\u062A\u064A\u0627\u0631 \u0628\u0631\u064A\u062F\u0643
      \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A \u0643\u0641\u0627\u0626\u0632
      \u0628\u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0623\u0648\u0644 \u0641\u064A
      \u0633\u062D\u0628 \u0627\u0644\u0630\u0643\u0631\u0649 \u0627\u0644\u0633\u0646\u0648\u064A\u0629
      \u0644\u0634\u0631\u0643\u0629 \u0646\u0648\u0646. \u0644\u0634\u062D\u0646
      \u0645\u062D\u0641\u0638\u062A\u0643 \u0648\u0633\u062D\u0628 \u0627\u0644\u062C\u0627\u0626\u0632\u0629
      \u0633\u062C\u0644 \u062F\u062E\u0648\u0644\u0643 \u0641\u0648\u0631\u0627\u064B:
      [\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u0644\u0637\u0645\u0639
      \u0643\u062D\u0627\u0641\u0632 \u0647\u0646\u062F\u0633\u0629 \u0627\u062C\u062A\u0645\u0627\u0639\u064A\u0629
      \u0648\u0637\u0644\u0628 \u062A\u0633\u062C\u064A\u0644 \u062F\u062E\u0648\u0644
      \u0644\u0631\u0628\u062D \u062C\u0627\u0626\u0632\u0629 \u0636\u062E\u0645\u0629
      \u0639\u0628\u0631 \u0628\u0631\u064A\u062F \u062C\u064A \u0645\u064A\u0644
      \u0645\u0646\u062A\u062D\u0644 \u0644\u0627\u0633\u0645 \u0645\u062A\u062C\u0631
      \u0646\u0648\u0646."
    messageType: 0
  - sender: security@snb-portal-update.com
    subject: "\u062A\u062D\u062F\u064A\u062B \u0623\u0645\u0646\u064A \u0625\u0644\u0632\u0627\u0645\u064A
      \u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0623\u0647\u0644\u064A
      \u0627\u0644\u0633\u0639\u0648\u062F\u064A"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u0628\u0643\u060C \u062A\u0645\u0627\u0634\u064A\u0627\u064B
      \u0645\u0639 \u0645\u0639\u0627\u064A\u064A\u0631 \u0627\u0644\u0623\u0645\u0627\u0646
      \u0627\u0644\u062C\u062F\u064A\u062F\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0623\u0647\u0644\u064A
      \u0644\u0639\u0627\u0645 2026\u060C \u064A\u062A\u0648\u062C\u0628 \u0639\u0644\u0649
      \u062C\u0645\u064A\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0625\u0639\u0627\u062F\u0629
      \u062A\u0648\u062B\u064A\u0642 \u0628\u0637\u0627\u0642\u0627\u062A \u0645\u062F\u0649
      \u0648\u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064A\u0629 \u0627\u0644\u0648\u0637\u0646\u064A\u0629
      \u0639\u0628\u0631 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629
      \u0627\u0644\u0645\u0631\u0641\u0642\u0629: [\u0627\u0646\u0642\u0631 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u064A\u0639\u062A\u0645\u062F \u0627\u0644\u0645\u0647\u0627\u062C\u0645
      \u0639\u0644\u0649 \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0646\u0637\u0627\u0642
      \u064A\u0634\u0628\u0647 \u0627\u0633\u0645 \u0627\u0644\u0628\u0646\u0643
      \u0644\u0625\u0636\u0641\u0627\u0621 \u0627\u0644\u0645\u0635\u062F\u0627\u0642\u064A\u0629\u060C
      \u0644\u0643\u0646 \u0627\u0644\u062A\u062F\u0642\u064A\u0642 \u0641\u064A
      \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0648\u0642\u0639 \u064A\u0643\u0634\u0641
      \u0623\u0646\u0647 \u0644\u064A\u0633 \u0627\u0644\u0646\u0637\u0627\u0642
      \u0627\u0644\u0631\u0633\u0645\u064A \u0644\u0644\u0628\u0646\u0643."
    messageType: 0
  - sender: it-support-helpdesk@outlook.com
    subject: "\u062A\u0646\u0628\u064A\u0647 \u0623\u0645\u0646\u064A \u0644\u062C\u0645\u064A\u0639
      \u0627\u0644\u0645\u0648\u0638\u0641\u064A\u0646: \u062A\u063A\u064A\u064A\u0631
      \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0628\u0648\u0627\u0628\u0629
      \u0627\u0644\u0645\u0648\u0627\u0631\u062F \u0627\u0644\u0628\u0634\u0631\u064A\u0629"
    content: "\u0627\u0644\u0632\u0645\u0644\u0627\u0621 \u0627\u0644\u0623\u0639\u0632\u0627\u0621\u060C
      \u064A\u0631\u062C\u0649 \u0627\u0644\u062A\u0643\u0631\u0645 \u0628\u062A\u062D\u062F\u064A\u062B
      \u0643\u0644\u0645\u0627\u062A \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062E\u0627\u0635\u0629
      \u0628\u0643\u0645 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649
      \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u062F\u0627\u062E\u0644\u064A
      \u0644\u0644\u0645\u0646\u0634\u0623\u0629 \u0642\u0628\u0644 \u0646\u0647\u0627\u064A\u0629
      \u0627\u0644\u062F\u0648\u0627\u0645 \u0627\u0644\u064A\u0648\u0645 \u0644\u062A\u062C\u0646\u0628
      \u0627\u0644\u0641\u0635\u0644 \u0645\u0646 \u0627\u0644\u062E\u062F\u0645\u0629:
      [\u0627\u0646\u0642\u0631 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0625\u062F\u0627\u0631\u0627\u062A \u0627\u0644\u0640 IT \u0648\u0627\u0644\u062F\u0639\u0645
      \u0627\u0644\u0641\u0646\u064A \u0627\u0644\u062F\u0627\u062E\u0644\u064A \u0644\u0644\u0634\u0631\u0643\u0627\u062A
      \u0644\u0627 \u064A\u0645\u0643\u0646 \u0623\u0646 \u062A\u0631\u0627\u0633\u0644
      \u0645\u0648\u0638\u0641\u064A\u0647\u0627 \u0639\u0628\u0631 \u062E\u0648\u0627\u062F\u0645
      \u0623\u0648\u062A\u0644\u0648\u0643 \u0627\u0644\u0634\u062E\u0635\u064A\u0629
      \u0627\u0644\u0645\u062C\u0627\u0646\u064A\u0629 \u0648\u062A\u0637\u0644\u0628
      \u0643\u0644\u0645\u0627\u062A \u0645\u0631\u0648\u0631\u0647\u0645 \u0644\u062F\u0648\u0627\u0639\u064A
      \u0627\u0644\u062D\u0645\u0627\u064A\u0629."
    messageType: 0
  - sender: moe-sa-edu@outlook.com
    subject: "\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062A\u0639\u0644\u064A\u0645:
      \u0625\u0639\u0644\u0627\u0646 \u0646\u062A\u0627\u0626\u062C \u062D\u0631\u0643\u0629
      \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u062E\u0627\u0631\u062C\u064A \u0644\u0644\u0645\u0639\u0644\u0645\u064A\u0646
      \u0648\u0627\u0644\u0645\u0639\u0644\u0645\u0627\u062A"
    content: "\u0627\u0644\u0632\u0645\u0644\u0627\u0621 \u0627\u0644\u0645\u0639\u0644\u0645\u064A\u0646\u060C
      \u062A\u0639\u0644\u0646 \u0627\u0644\u0648\u0632\u0627\u0631\u0629 \u0639\u0646
      \u0635\u062F\u0648\u0631 \u0646\u062A\u0627\u0626\u062C \u0627\u0644\u0646\u0642\u0644
      \u0644\u0639\u0627\u0645 2026. \u0644\u0645\u0639\u0631\u0641\u0629 \u0642\u0637\u0627\u0639\u0643
      \u0627\u0644\u062C\u062F\u064A\u062F \u0648\u062A\u0642\u062F\u064A\u0645 \u0627\u0644\u0627\u0639\u062A\u0631\u0627\u0636\u0627\u062A
      \u064A\u0631\u062C\u0649 \u0627\u0644\u062F\u062E\u0648\u0644 \u0639\u0628\u0631
      \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0631\u0641\u0642:
      [\u0627\u0646\u0642\u0631 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0627\u0646\u062A\u062D\u0627\u0644 \u0635\u0641\u0629 \u0648\u0632\u0627\u0631\u0629
      \u0627\u0644\u062A\u0639\u0644\u064A\u0645 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
      \u0628\u0631\u064A\u062F \u0645\u062C\u0627\u0646\u064A \u0644\u0627\u0633\u062A\u0647\u062F\u0627\u0641
      \u0634\u0631\u064A\u062D\u0629 \u0627\u0644\u0645\u0639\u0644\u0645\u064A\u0646
      \u0648\u0633\u0631\u0642\u0629 \u0628\u064A\u0627\u0646\u0627\u062A\u0647\u0645
      \u0627\u0644\u062D\u0633\u0627\u0633\u0629."
    messageType: 0
  - sender: urpay.customer-care@hotmail.com
    subject: "\u062A\u0646\u0628\u064A\u0647 \u0647\u0627\u0645: \u064A\u062A\u0648\u062C\u0628
      \u0639\u0644\u064A\u0643 \u062A\u062D\u062F\u064A\u062B \u0628\u064A\u0627\u0646\u0627\u062A
      \u0645\u062D\u0641\u0638\u0629 urpay \u0641\u0648\u0631\u0627\u064B"
    content: "\u0639\u0645\u064A\u0644\u0646\u0627 \u0627\u0644\u0639\u0632\u064A\u0632\u060C
      \u0644\u062A\u062C\u0646\u0628 \u062A\u062C\u0645\u064A\u062F \u0627\u0644\u0645\u0628\u0627\u0644\u063A
      \u0627\u0644\u0645\u0648\u062F\u0639\u0629 \u0641\u064A \u0645\u062D\u0641\u0638\u062A\u0643
      \u0627\u0644\u0631\u0642\u0645\u064A\u0629\u060C \u064A\u0631\u062C\u0649 \u0627\u0644\u0646\u0642\u0631
      \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062A\u0627\u0644\u064A
      \u0644\u0625\u0639\u0627\u062F\u0629 \u062A\u0623\u0643\u064A\u062F \u0631\u0642\u0645
      \u0627\u0644\u0625\u0642\u0627\u0645\u0629/\u0627\u0644\u0647\u0648\u064A\u0629
      \u0648\u0627\u0644\u0631\u0645\u0632 \u0627\u0644\u0633\u0631\u064A: [\u0627\u0646\u0642\u0631
      \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0627\u0646\u062A\u062D\u0627\u0644 \u0635\u0641\u0629 \u0645\u062D\u0641\u0638\u0629
      urpay \u0639\u0628\u0631 \u0628\u0631\u064A\u062F \u0647\u0648\u062A\u0645\u064A\u0644
      \u0645\u062C\u0627\u0646\u064A \u0648\u0637\u0644\u0628 \u0628\u064A\u0627\u0646\u0627\u062A
      \u0628\u0627\u0644\u063A\u0629 \u0627\u0644\u0633\u0631\u064A\u0629 \u0643\u0627\u0644\u0631\u0645\u0632
      \u0627\u0644\u0633\u0631\u064A \u0644\u0644\u062D\u0633\u0627\u0628."
    messageType: 0
  - sender: zatca.refund-tax@gmail.com
    subject: "\u0647\u064A\u0626\u0629 \u0627\u0644\u0632\u0643\u0627\u0629 \u0648\u0627\u0644\u0636\u0631\u064A\u0628\u0629:
      \u0644\u062F\u064A\u0643 \u0645\u0633\u062A\u062D\u0642\u0627\u062A \u0627\u0633\u062A\u0631\u062F\u0627\u062F
      \u0645\u0627\u0644\u064A \u0628\u0642\u064A\u0645\u0629 3,400 \u0631\u064A\u0627\u0644"
    content: "\u0627\u0644\u0645\u0643\u0644\u0641 \u0627\u0644\u0639\u0632\u064A\u0632\u060C
      \u0628\u0646\u0627\u0621\u064B \u0639\u0644\u0649 \u0627\u0644\u0641\u0631\u0632
      \u0627\u0644\u0633\u0646\u0648\u064A \u0644\u0644\u062D\u0633\u0627\u0628\u0627\u062A
      \u0627\u0644\u0636\u0631\u064A\u0628\u064A\u0629\u060C \u062A\u0628\u064A\u0646
      \u0648\u062C\u0648\u062F \u0631\u0635\u064A\u062F \u062F\u0627\u0626\u0646
      \u0645\u0633\u062A\u062D\u0642 \u0644\u0643. \u064A\u0631\u062C\u0649 \u0625\u062F\u062E\u0627\u0644
      \u0628\u064A\u0627\u0646\u0627\u062A \u0628\u0637\u0627\u0642\u062A\u0643 \u0627\u0644\u0628\u0646\u0643\u064A\u0629
      \u0644\u064A\u062A\u0645 \u062A\u062D\u0648\u064A\u0644 \u0627\u0644\u0645\u0628\u0644\u063A
      \u0641\u0648\u0631\u0627\u064B: [\u0627\u0646\u0642\u0631 \u0639\u0644\u0649
      \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0627\u0644\u0647\u064A\u0626\u0629 \u062A\u0633\u062A\u062E\u062F\u0645
      \u0627\u0644\u0646\u0637\u0627\u0642\u0627\u062A \u0627\u0644\u062D\u0643\u0648\u0645\u064A\u0629
      (.gov.sa) \u0648\u0644\u0627 \u062A\u0637\u0644\u0628 \u0628\u0637\u0627\u0642\u0627\u062A
      \u0628\u0646\u0643\u064A\u0629 \u0644\u0627\u0633\u062A\u0631\u062F\u0627\u062F
      \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0628\u0644 \u062A\u0639\u062A\u0645\u062F
      \u0639\u0644\u0649 \u0627\u0644\u0622\u064A\u0628\u0627\u0646 \u0627\u0644\u0645\u0633\u062C\u0644
      \u0628\u0627\u0644\u0645\u0646\u0638\u0645\u0629."
    messageType: 0
  - sender: facebook-copyright-claims@gmail.com
    subject: "\u0639\u0627\u062C\u0644: \u0633\u064A\u062A\u0645 \u062D\u0630\u0641
      \u0635\u0641\u062D\u062A\u0643 \u0639\u0644\u0649 \u0641\u064A\u0633\u0628\u0648\u0643
      \u0646\u0647\u0627\u0626\u064A\u0627\u064B \u062E\u0644\u0627\u0644 48 \u0633\u0627\u0639\u0629"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u060C
      \u062A\u0644\u0642\u064A\u0646\u0627 \u0634\u0643\u0627\u0648\u0649 \u062A\u062A\u0639\u0644\u0642
      \u0628\u0627\u0646\u062A\u0647\u0627\u0643 \u062D\u0642\u0648\u0642 \u0627\u0644\u0645\u0644\u0643\u064A\u0629
      \u0627\u0644\u0641\u0643\u0631\u064A\u0629 \u0628\u0634\u0623\u0646 \u0645\u062D\u062A\u0648\u0649
      \u0635\u0641\u062D\u062A\u0643. \u0644\u062A\u0642\u062F\u064A\u0645 \u0637\u0639\u0646
      \u0636\u062F \u0647\u0630\u0627 \u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064A
      \u0648\u0645\u0646\u0639 \u0627\u0644\u062D\u0630\u0641\u060C \u064A\u0631\u062C\u0649
      \u062A\u0639\u0628\u0626\u0629 \u0627\u0644\u0646\u0645\u0648\u0630\u062C:
      [\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u062A\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u0631\u0633\u0627\u0644\u0629
      \u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0627\u0633\u062A\u0639\u062C\u0627\u0644
      \u0648\u0627\u0644\u062A\u0647\u062F\u064A\u062F \u0628\u062D\u0630\u0641 \u0627\u0644\u0635\u0641\u062D\u0629
      \u0644\u0625\u062C\u0628\u0627\u0631 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645
      \u0639\u0644\u0649 \u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637\u060C
      \u0643\u0645\u0627 \u0623\u0646 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u0631\u064A\u062F
      \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A \u0644\u0627 \u064A\u062A\u0628\u0639
      \u0627\u0644\u062C\u0647\u0629 \u0627\u0644\u0631\u0633\u0645\u064A\u0629\u060C
      \u0645\u0645\u0627 \u064A\u062B\u064A\u0631 \u0627\u0644\u0634\u0643 \u0641\u064A
      \u0645\u0635\u062F\u0627\u0642\u064A\u062A\u0647\u0627."
    messageType: 0
  - sender: absher.support-team@yahoo.com
    subject: "\u0645\u0646\u0635\u0629 \u0623\u0628\u0634\u0631: \u062A\u062D\u062F\u064A\u062B
      \u0628\u0635\u0645\u0629 \u0627\u0644\u0639\u064A\u0646 \u0648\u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
      \u0627\u0644\u062D\u064A\u0648\u064A\u0629 \u0645\u0637\u0644\u0648\u0628"
    content: "\u0623\u062E\u064A \u0627\u0644\u0645\u0648\u0627\u0637\u0646 / \u0627\u0644\u0645\u0642\u064A\u0645\u060C
      \u064A\u0631\u062C\u0649 \u062A\u062D\u062F\u064A\u062B \u0628\u064A\u0627\u0646\u0627\u062A\u0643
      \u0627\u0644\u062D\u064A\u0648\u064A\u0629 \u062A\u0641\u0627\u062F\u064A\u0627\u064B
      \u0644\u0625\u064A\u0642\u0627\u0641 \u0627\u0644\u062E\u062F\u0645\u0627\u062A
      \u0627\u0644\u062D\u0643\u0648\u0645\u064A\u0629 \u0639\u0646 \u0647\u0648\u064A\u062A\u0643.
      \u0627\u0636\u063A\u0637 \u0647\u0646\u0627 \u0644\u062A\u0648\u062B\u064A\u0642
      \u0627\u0644\u062F\u062E\u0648\u0644 \u0639\u0628\u0631 \u0627\u0644\u0646\u0641\u0627\u0630
      \u0627\u0644\u0648\u0637\u0646\u064A: [\u0627\u0646\u0642\u0631 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0627\u0644\u0645\u0646\u0635\u0627\u062A \u0627\u0644\u0633\u064A\u0627\u062F\u064A\u0629
      \u0644\u0644\u062F\u0648\u0644\u0629 \u0644\u0627 \u062A\u0633\u062A\u062E\u062F\u0645
      \u062E\u0648\u0627\u062F\u0645 \u064A\u0627\u0647\u0648 \u0627\u0644\u0645\u062C\u0627\u0646\u064A\u0629\u060C
      \u0648\u062A\u062D\u062F\u064A\u062B \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
      \u0644\u0627 \u064A\u062A\u0645 \u0639\u0628\u0631 \u0631\u0648\u0627\u0628\u0637
      \u0628\u0631\u064A\u062F\u064A\u0629 \u0639\u0634\u0648\u0627\u0626\u064A\u0629."
    messageType: 0
  - sender: spotify-account-verify@yahoo.com
    subject: "\u26A0\uFE0F \u0639\u0627\u062C\u0644: \u0642\u0627\u0645 \u0634\u062E\u0635
      \u0645\u0627 \u0628\u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649
      \u062D\u0633\u0627\u0628 Spotify Premium \u0627\u0644\u062E\u0627\u0635 \u0628\u0643"
    content: "\u0644\u0627\u062D\u0638\u0646\u0627 \u062A\u0633\u062C\u064A\u0644
      \u062F\u062E\u0648\u0644 \u0645\u0634\u0628\u0648\u0647 \u0625\u0644\u0649
      \u062D\u0633\u0627\u0628\u0643 \u0645\u0646 \u0631\u0648\u0633\u064A\u0627.
      \u0625\u0630\u0627 \u0644\u0645 \u062A\u0643\u0646 \u0623\u0646\u062A \u0645\u0646
      \u0642\u0627\u0645 \u0628\u0630\u0644\u0643\u060C \u064A\u0631\u062C\u0649
      \u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646 \u0643\u0644\u0645\u0629
      \u0627\u0644\u0645\u0631\u0648\u0631 \u0641\u0648\u0631\u0627\u064B \u0639\u0628\u0631
      \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0631\u0641\u0642 \u0644\u0645\u0646\u0639
      \u0625\u063A\u0644\u0627\u0642 \u0627\u0644\u062D\u0633\u0627\u0628: [\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0634\u0631\u0643\u0629 \u0633\u0628\u0648\u062A\u064A\u0641\u0627\u064A
      \u0644\u0627 \u062A\u0631\u0633\u0644 \u062A\u062D\u0630\u064A\u0631\u0627\u062A
      \u0627\u0644\u0627\u062E\u062A\u0631\u0627\u0642 \u0648\u0627\u0644\u062A\u0633\u062C\u064A\u0644
      \u0627\u0644\u0645\u0634\u0628\u0648\u0647 \u0645\u0646 \u0628\u0631\u064A\u062F
      \u064A\u0627\u0647\u0648 \u0645\u062C\u0627\u0646\u064A."
    messageType: 0
  - sender: alrajhibank.support2026@gmail.com
    subject: "\u26A0\uFE0F \u0625\u0646\u0630\u0627\u0631 \u0646\u0647\u0627\u0626\u064A:
      \u062A\u062C\u0645\u064A\u062F \u062D\u0633\u0627\u0628\u0643 \u0627\u0644\u0628\u0646\u0643\u064A
      \u062E\u0644\u0627\u0644 24 \u0633\u0627\u0639\u0629"
    content: "\u0639\u0645\u064A\u0644\u0646\u0627 \u0627\u0644\u0639\u0632\u064A\u0632\u060C
      \u062A\u0645 \u0631\u0635\u062F \u0639\u0645\u0644\u064A\u0627\u062A \u062F\u062E\u0648\u0644
      \u0645\u0634\u0628\u0648\u0647\u0629 \u0645\u0646 \u062E\u0627\u0631\u062C
      \u0627\u0644\u0645\u0645\u0644\u0643\u0629. \u0644\u062A\u0641\u0627\u062F\u064A
      \u062A\u062C\u0645\u064A\u062F \u062D\u0633\u0627\u0628\u0643 \u0648\u0628\u0637\u0627\u0642\u0627\u062A\u0643
      \u0627\u0644\u0627\u0626\u062A\u0645\u0627\u0646\u064A\u0629 \u0628\u0634\u0643\u0644
      \u0646\u0647\u0627\u0626\u064A\u060C \u064A\u0631\u062C\u0649 \u0627\u0644\u062F\u062E\u0648\u0644
      \u0641\u0648\u0631\u0627\u064B \u0648\u062A\u062D\u062F\u064A\u062B \u0628\u064A\u0627\u0646\u0627\u062A
      \u0627\u0644\u0646\u0641\u0627\u0630 \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0643
      \u0639\u0628\u0631 \u0627\u0644\u0631\u0627\u0628\u0637: [\u0627\u0646\u0642\u0631
      \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u064A\u0645\u0643\u0646 \u0627\u0643\u062A\u0634\u0627\u0641 \u0627\u0644\u0627\u062D\u062A\u064A\u0627\u0644
      \u0628\u0633\u0647\u0648\u0644\u0629 \u0645\u0646 \u0627\u0633\u062A\u062E\u062F\u0627\u0645
      \u0628\u0631\u064A\u062F Gmail \u063A\u064A\u0631 \u0631\u0633\u0645\u064A
      \u0644\u0627\u0646\u062A\u062D\u0627\u0644 \u0635\u0641\u0629 \u0627\u0644\u0628\u0646\u0643\u060C
      \u0625\u0636\u0627\u0641\u0629\u064B \u0625\u0644\u0649 \u0627\u0644\u062A\u0647\u062F\u064A\u062F
      \u0628\u062A\u062C\u0645\u064A\u062F \u0627\u0644\u062D\u0633\u0627\u0628 \u0644\u062D\u062B
      \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u0639\u0644\u0649 \u0627\u0644\u062A\u0635\u0631\u0641
      \u0628\u0633\u0631\u0639\u0629."
    messageType: 0
  - sender: spl-post-taxes@gmail.com
    subject: "\u0633\u0628\u0644: \u0631\u0633\u0648\u0645 \u0636\u0631\u064A\u0628\u0629
      \u0627\u0644\u0642\u064A\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629
      \u0645\u0639\u0644\u0642\u0629 \u0639\u0644\u0649 \u0634\u062D\u0646\u062A\u0643
      \u0627\u0644\u0628\u0631\u064A\u062F\u064A\u0629"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u0628\u0643\u060C \u0644\u062F\u064A\u0643
      \u0637\u0631\u062F \u0648\u0627\u0631\u062F \u0645\u0646 \u0627\u0644\u062E\u0627\u0631\u062C
      \u064A\u062D\u0645\u0644 \u0627\u0644\u0631\u0642\u0645 SPL-9382. \u064A\u062A\u0648\u062C\u0628
      \u0639\u0644\u064A\u0643 \u0633\u062F\u0627\u062F \u0627\u0644\u0636\u0631\u064A\u0628\u0629
      \u0627\u0644\u0628\u0627\u0644\u063A\u0629 14.50 \u0631\u064A\u0627\u0644 \u0644\u062A\u062A\u0645\u0643\u0646
      \u0645\u0646 \u0627\u0633\u062A\u0644\u0627\u0645 \u0627\u0644\u0637\u0631\u062F:
      [\u0631\u0627\u0628\u0637 \u0627\u0644\u062F\u0641\u0639]"
    isScam: 1
    explanation: "\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u062D\u0633\u0627\u0628
      \u0628\u0631\u064A\u062F \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A \u0645\u062C\u0627\u0646\u064A
      \u0628\u0627\u0633\u0645 (spl-post-taxes) \u0644\u0627\u0635\u0637\u064A\u0627\u062F
      \u0627\u0644\u0636\u062D\u0627\u064A\u0627 \u0639\u0628\u0631 \u0641\u0648\u0627\u062A\u064A\u0631
      \u0648\u0647\u0645\u064A\u0629 \u0628\u0642\u064A\u0645 \u0645\u0627\u0644\u064A\u0629
      \u0645\u0646\u062E\u0641\u0636\u0629 \u0644\u0636\u0645\u0627\u0646 \u0627\u0633\u062A\u062C\u0627\u0628\u062A\u0647\u0645."
    messageType: 0
  - sender: binance-security-alerts@outlook.com
    subject: "\u26A0\uFE0F \u062A\u0646\u0628\u064A\u0647 \u0623\u0645\u0646\u064A:
      \u0633\u064A\u062A\u0645 \u062A\u062C\u0645\u064A\u062F \u0623\u0635\u0648\u0644\u0643
      \u0627\u0644\u0631\u0642\u0645\u064A\u0629 \u0628\u0633\u0628\u0628 \u062A\u0648\u062B\u064A\u0642
      \u0627\u0644\u0647\u0648\u064A\u0629 (KYC)"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0645\u0633\u062A\u062B\u0645\u0631\u060C
      \u0648\u0641\u0642\u0627\u064B \u0644\u0644\u0648\u0627\u0626\u062D \u0627\u0644\u062F\u0648\u0644\u064A\u0629
      \u0644\u0645\u0643\u0627\u0641\u062D\u0629 \u063A\u0633\u064A\u0644 \u0627\u0644\u0623\u0645\u0648\u0627\u0644\u060C
      \u064A\u062C\u0628 \u0639\u0644\u064A\u0643 \u0625\u0639\u0627\u062F\u0629
      \u062A\u0648\u062B\u064A\u0642 \u0647\u0648\u064A\u062A\u0643 \u0648\u0645\u0641\u0627\u062A\u064A\u062D
      \u0627\u0644\u0623\u0645\u0627\u0646 \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0643
      \u062E\u0644\u0627\u0644 6 \u0633\u0627\u0639\u0627\u062A\u060C \u0648\u0625\u0644\u0627
      \u0633\u064A\u062A\u0645 \u0642\u0641\u0644 \u0645\u062D\u0641\u0638\u062A\u0643:
      [\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0645\u0646\u0635\u0627\u062A \u062A\u062F\u0627\u0648\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u062A
      \u0627\u0644\u0645\u0634\u0641\u0631\u0629 \u0643\u0640 Binance \u062A\u0633\u062A\u062E\u062F\u0645
      \u0628\u0631\u0648\u062A\u0648\u0643\u0648\u0644\u0627\u062A \u062D\u0645\u0627\u064A\u0629
      \u0645\u062A\u0637\u0648\u0631\u0629 \u0648\u0646\u0637\u0627\u0642\u0627\u062A
      \u062E\u0627\u0635\u0629 \u0628\u0647\u0627\u060C \u0648\u0644\u0627 \u062A\u0631\u0627\u0633\u0644
      \u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0641\u0627\u062A\u064A\u062D \u0627\u0644\u0633\u0631\u064A\u0629
      \u0639\u0628\u0631 \u0623\u0648\u062A\u0644\u0648\u0643."
    messageType: 0
  - sender: playstation-network-rewards@gmail.com
    subject: "\u0639\u0631\u0636 \u0643\u0648\u062F \u0645\u062D\u0641\u0638\u0629
      PSN \u0645\u062C\u0627\u0646\u064A \u0628\u0642\u064A\u0645\u0629 50 \u062F\u0648\u0644\u0627\u0631\u0627\u064B
      \u0644\u0645\u0633\u062A\u062E\u062F\u0650\u0645\u064A PS5!"
    content: "\u062A\u0647\u0627\u0646\u064A\u0646\u0627! \u062A\u0645 \u0627\u062E\u062A\u064A\u0627\u0631\u0643
      \u0644\u062A\u0644\u0642\u064A \u0643\u0648\u062F \u0631\u0642\u0645\u064A
      \u0645\u062C\u0627\u0646\u064A \u0628\u0642\u064A\u0645\u0629 50 \u062F\u0648\u0644\u0627\u0631\u0627\u064B
      \u0623\u0645\u0631\u064A\u0643\u064A\u0627\u064B \u0641\u064A \u0645\u062D\u0641\u0638\u0629
      \u0628\u0644\u0627\u064A\u0633\u062A\u064A\u0634\u0646 \u0627\u0644\u062E\u0627\u0635\u0629
      \u0628\u0643. \u0637\u0627\u0644\u0628 \u0628\u0643\u0648\u062F\u0643 \u0627\u0644\u0645\u062C\u0627\u0646\u064A
      \u0627\u0644\u0622\u0646 \u0639\u0646 \u0637\u0631\u064A\u0642 \u0625\u062F\u062E\u0627\u0644
      \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 PSN \u0627\u0644\u062E\u0627\u0635\u0629
      \u0628\u0643 \u0647\u0646\u0627: [\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0637\u0644\u0628 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631
      \u0634\u0628\u0643\u0629 \u0628\u0644\u0627\u064A\u0633\u062A\u064A\u0634\u0646
      \u0639\u0628\u0631 \u0635\u0641\u062D\u0629 \u062E\u0627\u0631\u062C\u064A\u0629
      \u0645\u0631\u0633\u0644\u0629 \u0645\u0646 \u062D\u0633\u0627\u0628 \u062C\u064A
      \u0645\u064A\u0644 \u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649
      \u062C\u0648\u0627\u0626\u0632 \u0645\u062C\u0627\u0646\u064A\u0629 \u0647\u0648
      \u0641\u062E \u0627\u062E\u062A\u0631\u0627\u0642 \u0645\u0643\u0634\u0648\u0641."
    messageType: 0
  - sender: fedex-notice-center@gmail.com
    subject: "\u0641\u064A\u062F\u0643\u0633 \u0625\u0643\u0633\u0628\u0631\u064A\u0633:
      \u062A\u0646\u0628\u064A\u0647 \u0647\u0627\u0645 \u0628\u062E\u0635\u0648\u0635
      \u0634\u062D\u0646\u062A\u0643 \u0627\u0644\u062F\u0648\u0644\u064A\u0629"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u062A\u062D\u062A\u0648\u064A \u0634\u062D\u0646\u062A\u0643 \u0639\u0644\u0649
      \u0645\u0648\u0627\u062F \u063A\u064A\u0631 \u0645\u0648\u062B\u0642\u0629.
      \u0644\u062A\u062E\u0644\u064A\u0635 \u0627\u0644\u0634\u062D\u0646\u0629\u060C
      \u064A\u0631\u062C\u0649 \u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u062F\u062E\u0648\u0644
      \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0628\u064A\u0627\u0646\u0627\u062A
      \u0628\u0631\u064A\u062F \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u062E\u0627\u0635
      \u0628\u0643 \u0639\u0644\u0649 \u0628\u0648\u0627\u0628\u062A\u0646\u0627
      \u0627\u0644\u0622\u0645\u0646\u0629: [\u0627\u0646\u0642\u0631 \u0639\u0644\u0649
      \u0627\u0644\u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0627\u0633\u062A\u0647\u062F\u0627\u0641 \u0630\u0643\u064A \u064A\u0637\u0644\u0628
      \u062A\u0633\u062C\u064A\u0644 \u062F\u062E\u0648\u0644 \u0628\u0628\u0631\u064A\u062F
      \u0627\u0644\u0639\u0645\u0644 \u0644\u0633\u0631\u0642\u0629 \u0628\u064A\u0627\u0646\u0627\u062A
      \u0627\u0644\u0634\u0631\u0643\u0627\u062A\u060C \u0648\u0627\u0644\u0645\u0631\u0633\u0644
      \u0628\u0631\u064A\u062F \u062C\u064A \u0645\u064A\u0644 \u0639\u0634\u0648\u0627\u0626\u064A."
    messageType: 0
  - sender: pubg-mobile-uc-giveaway@outlook.com
    subject: "\u0634\u062D\u0646 5000 \u0634\u062F\u0629 \u0628\u0628\u062C\u064A
      \u0645\u062C\u0627\u0646\u0627\u064B \u0644\u062C\u0645\u064A\u0639 \u0627\u0644\u0644\u0627\u0639\u0628\u064A\u0646
      \u0628\u0645\u0646\u0627\u0633\u0628\u0629 \u0627\u0644\u0645\u0648\u0633\u0645
      \u0627\u0644\u062C\u062F\u064A\u062F"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u064A\u0627 \u0628\u0637\u0644\u060C
      \u0644\u0633\u062A \u0628\u062D\u0627\u062C\u0629 \u0644\u0644\u062F\u0641\u0639
      \u0628\u0639\u062F \u0627\u0644\u0622\u0646! \u0627\u0636\u063A\u0637 \u0639\u0644\u0649
      \u0627\u0644\u0631\u0627\u0628\u0637 \u0648\u0633\u062C\u0644 \u062F\u062E\u0648\u0644\u0643
      \u0628\u062D\u0633\u0627\u0628 \u062A\u0648\u064A\u062A\u0631 \u0623\u0648
      \u0641\u064A\u0633\u0628\u0648\u0643 \u0627\u0644\u0645\u0631\u062A\u0628\u0637
      \u0628\u0644\u0639\u0628\u062A\u0643 \u0644\u0627\u0633\u062A\u0644\u0627\u0645
      \u0627\u0644\u0634\u062F\u0627\u062A \u0627\u0644\u0645\u062C\u0627\u0646\u064A\u0629
      \u0641\u0648\u0631\u0627\u064B \u0641\u064A \u0645\u062E\u0632\u0646\u0643:
      [ \u0627\u0646\u0642\u0631 \u0647\u0646\u0627 \u0631\u0627\u0628\u0637]"
    isScam: 1
    explanation: "\u0627\u0646\u062A\u062D\u0627\u0644 \u0635\u0641\u0629 \u0644\u0639\u0628\u0629
      PUBG \u0644\u0633\u0631\u0642\u0629 \u062D\u0633\u0627\u0628\u0627\u062A \u0627\u0644\u062A\u0648\u0627\u0635\u0644
      \u0627\u0644\u0627\u062C\u062A\u0645\u0627\u0639\u064A \u0627\u0644\u0645\u0631\u062A\u0628\u0637\u0629
      \u0628\u0627\u0644\u0644\u0639\u0628\u0629 \u0639\u0646 \u0637\u0631\u064A\u0642
      \u0628\u0631\u064A\u062F \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A \u0645\u062C\u0627\u0646\u064A
      \u0645\u0646 \u0623\u0648\u062A\u0644\u0648\u0643 \u0648\u0639\u0631\u0648\u0636
      \u0648\u0647\u0645\u064A\u0629."
    messageType: 0
  - sender: spl.national-address-service@outlook.com
    subject: "\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0628\u0631\u064A\u062F
      \u0627\u0644\u0633\u0639\u0648\u062F\u064A (\u0633\u0628\u0644): \u0639\u0646\u0648\u0627\u0646\u0643
      \u0627\u0644\u0648\u0637\u0646\u064A \u063A\u064A\u0631 \u0645\u0643\u062A\u0645\u0644"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0645\u0633\u062A\u0641\u064A\u062F\u060C
      \u064A\u0631\u062C\u0649 \u062A\u0639\u062F\u064A\u0644 \u0648\u062A\u0648\u062B\u064A\u0642
      \u0639\u0646\u0648\u0627\u0646\u0643 \u0627\u0644\u0648\u0637\u0646\u064A \u0627\u0644\u0645\u0633\u062C\u0644
      \u0644\u0636\u0645\u0627\u0646 \u0648\u0635\u0648\u0644 \u0627\u0644\u0634\u062D\u0646\u0627\u062A
      \u0627\u0644\u062D\u0643\u0648\u0645\u064A\u0629 \u0648\u0627\u0644\u0631\u0633\u0627\u0626\u0644
      \u0627\u0644\u0642\u0636\u0627\u0626\u064A\u0629 \u0641\u064A \u0648\u0642\u062A\u0647\u0627.
      \u0627\u0636\u063A\u0637 \u0647\u0646\u0627 \u0644\u0644\u062A\u0648\u062B\u064A\u0642:
      [\u0631\u0627\u0628\u0637 \u0627\u0644\u062A\u0648\u062B\u064A\u0642]"
    isScam: 1
    explanation: "\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0628\u0631\u064A\u062F
      \u0623\u0648\u062A\u0644\u0648\u0643 \u0644\u0627\u0646\u062A\u062D\u0627\u0644
      \u0627\u0644\u0628\u0631\u064A\u062F \u0627\u0644\u0633\u0639\u0648\u062F\u064A
      '\u0633\u0628\u0644' \u0644\u0633\u0631\u0642\u0629 \u062D\u0633\u0627\u0628\u0627\u062A
      \u0627\u0644\u0646\u0641\u0627\u0630 \u0627\u0644\u0645\u0648\u062D\u062F \u0644\u0644\u0636\u062D\u0627\u064A\u0627."
    messageType: 0
  - sender: stcpay.rewards-bonus@gmail.com
    subject: "\u0647\u062F\u064A\u0629 \u0645\u0641\u0627\u062C\u0626\u0629: \u0627\u0633\u062A\u0631\u062F\u0627\u062F
      \u0646\u0642\u062F\u064A 600 \u0631\u064A\u0627\u0644 \u0628\u0645\u0646\u0627\u0633\u0628\u0629
      \u0627\u0644\u0635\u064A\u0641"
    content: "\u0639\u0632\u064A\u0632\u064A \u0645\u0633\u062A\u062E\u062F\u0645
      \u0645\u062D\u0641\u0638\u0629 stc pay\u060C \u062A\u0647\u0627\u0646\u064A\u0646\u0627!
      \u062A\u0645 \u0627\u062E\u062A\u064A\u0627\u0631 \u0631\u0642\u0645\u0643
      \u0644\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0643\u0627\u0641\u0623\u0629
      \u0646\u0642\u062F\u064A\u0629 \u0641\u0648\u0631\u064A\u0629. \u0627\u0636\u063A\u0637
      \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062A\u0627\u0644\u064A
      \u0648\u0623\u062F\u062E\u0644 \u0631\u0645\u0632 \u0627\u0644\u062A\u062D\u0642\u0642
      \u0627\u0644\u0645\u0631\u0633\u0644 \u0644\u0647\u0627\u062A\u0641\u0643 \u0644\u062A\u0641\u0639\u064A\u0644
      \u0627\u0644\u0631\u0635\u064A\u062F: [\u0627\u0636\u063A\u0637 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0637\u0644\u0628 \u0631\u0645\u0632 \u0627\u0644\u062A\u062D\u0642\u0642
      (OTP) \u0639\u0628\u0631 \u0631\u0627\u0628\u0637 \u0645\u0646 \u0628\u0631\u064A\u062F
      \u062C\u064A \u0645\u064A\u0644 \u0647\u0648 \u0623\u0633\u0644\u0648\u0628
      \u0647\u0646\u062F\u0633\u0629 \u0627\u062C\u062A\u0645\u0627\u0639\u064A\u0629
      \u0645\u0643\u0634\u0648\u0641 \u0644\u0633\u0631\u0642\u0629 \u0627\u0644\u0645\u062D\u0641\u0638\u0629."
    messageType: 0
  - sender: shahidvip-discount@outlook.com
    subject: "\u0639\u0631\u0636 \u062E\u0627\u0635: \u0627\u0634\u062A\u0631\u0627\u0643
      \u0633\u0646\u0629 \u0643\u0627\u0645\u0644\u0629 \u0641\u064A \u0634\u0627\u0647\u062F
      VIP \u0628\u0640 15 \u0631\u064A\u0627\u0644 \u0641\u0642\u0637 \u0628\u0645\u0646\u0627\u0633\u0628\u0629
      \u0627\u0644\u0639\u064A\u062F"
    content: "\u0623\u0647\u0644\u0627\u064B \u0628\u0643\u060C \u0627\u062D\u0635\u0644
      \u0627\u0644\u0622\u0646 \u0639\u0644\u0649 \u0648\u0635\u0648\u0644 \u0643\u0627\u0645\u0644
      \u0644\u0643\u0627\u0641\u0629 \u0627\u0644\u0645\u0633\u0644\u0633\u0644\u0627\u062A
      \u0648\u0627\u0644\u0623\u0641\u0644\u0627\u0645 \u0627\u0644\u062D\u0635\u0631\u064A\u0629
      \u0628\u062C\u0648\u062F\u0629 4K \u0644\u0645\u062F\u0629 \u0639\u0627\u0645
      \u0643\u0627\u0645\u0644 \u0628\u062A\u062E\u0641\u064A\u0636 90%. \u0627\u0646\u0642\u0631
      \u0644\u0644\u0627\u0634\u062A\u0631\u0627\u0643 \u0648\u0627\u0644\u062F\u0641\u0639
      \u0628\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u062F\u0649:
      [\u0627\u0636\u063A\u0637 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0645\u0646\u0635\u0629 \u0634\u0627\u0647\u062F \u0644\u0627
      \u062A\u0642\u062F\u0645 \u0639\u0631\u0648\u0636\u0627\u064B \u0628\u0623\u0633\u0639\u0627\u0631
      \u0648\u0647\u0645\u064A\u0629 \u0648\u063A\u064A\u0631 \u0645\u0646\u0637\u0642\u064A\u0629
      \u0639\u0628\u0631 \u062D\u0633\u0627\u0628\u0627\u062A \u0628\u0631\u064A\u062F
      \u0623\u0648\u062A\u0644\u0648\u0643 \u0627\u0644\u0634\u062E\u0635\u064A\u0629
      \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629 \u0644\u0644\u062C\u0645\u064A\u0639."
    messageType: 0
  - sender: dhl-tracking-desk@gmail.com
    subject: "\u0637\u0631\u062F\u0643 \u0645\u0639\u0644\u0642 \u0641\u064A \u0627\u0644\u062C\u0645\u0627\u0631\u0643:
      \u064A\u062A\u0648\u062C\u0628 \u062F\u0641\u0639 \u0631\u0633\u0648\u0645
      \u0628\u064A\u0627\u0646 \u062C\u0645\u0631\u0643\u064A 22 \u0631\u064A\u0627\u0644"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B\u060C \u062A\u0639\u0630\u0631
      \u062A\u0648\u0635\u064A\u0644 \u0627\u0644\u0634\u062D\u0646\u0629 \u0627\u0644\u062F\u0648\u0644\u064A\u0629
      \u0631\u0642\u0645 #7739281 \u0628\u0633\u0628\u0628 \u0646\u0642\u0635 \u0627\u0644\u0631\u0633\u0648\u0645.
      \u064A\u0631\u062C\u0649 \u0627\u0633\u062A\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064A\u0629
      \u0627\u0644\u0633\u062F\u0627\u062F \u0644\u0641\u0643 \u062D\u062C\u0632
      \u0627\u0644\u0634\u062D\u0646\u0629 \u0648\u062A\u0641\u0627\u062F\u064A \u0625\u0639\u0627\u062F\u062A\u0647\u0627
      \u0644\u0644\u0645\u0635\u062F\u0631: [\u0627\u0636\u063A\u0637 \u0647\u0646\u0627]"
    isScam: 1
    explanation: "\u0634\u0631\u0643\u0629 DHL \u0644\u0627 \u062A\u0633\u062A\u062E\u062F\u0645
      \u062D\u0633\u0627\u0628\u0627\u062A Gmail \u0644\u0645\u0637\u0627\u0644\u0628\u0629
      \u0639\u0645\u0644\u0627\u0626\u0647\u0627 \u0628\u062A\u0633\u062F\u064A\u062F
      \u0627\u0644\u0631\u0633\u0648\u0645 \u0648\u062A\u0645\u0631\u064A\u0631 \u0641\u0648\u0627\u062A\u064A\u0631
      \u0627\u0644\u062F\u0641\u0639 \u0627\u0644\u062C\u0645\u0631\u0643\u064A\u0629."
    messageType: 0
  - sender: sony@playstation.com
    subject: "\u0634\u0643\u0631\u0627\u064B \u0644\u0643 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0627\u0621
      \u0645\u0646 \u0645\u062A\u062C\u0631 \u0628\u0644\u0627\u064A\u0633\u062A\u064A\u0634\u0646"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B\u060C \u0647\u0630\u0627 \u0625\u064A\u0635\u0627\u0644
      \u0631\u0642\u0645\u064A \u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u062A\u064A
      \u0642\u0645\u062A \u0628\u0634\u0631\u0627\u0626\u0647\u0627 \u0645\u0624\u062E\u0631\u0627\u064B.
      \u0627\u0644\u062A\u0646\u0632\u064A\u0644 \u0645\u062A\u0627\u062D \u0627\u0644\u0622\u0646
      \u0639\u0644\u0649 \u0645\u0646\u0635\u062A\u0643. \u0645\u0639\u0631\u0641
      \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629: 9483920194."
    isScam: 0
    explanation: "\u0641\u0627\u062A\u0648\u0631\u0629 \u0631\u0642\u0645\u064A\u0629
      \u0631\u0633\u0645\u064A\u0629 \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642
      \u0627\u0644\u0645\u0648\u062B\u0642 \u0644\u0634\u0631\u0643\u0629 \u0633\u0648\u0646\u064A
      \u0628\u0644\u0627\u064A\u0633\u062A\u064A\u0634\u0646 \u0644\u062D\u0645\u0627\u064A\u0629
      \u0648\u062A\u0648\u062B\u064A\u0642 \u0645\u0634\u062A\u0631\u064A\u0627\u062A
      \u0627\u0644\u0644\u0627\u0639\u0628\u064A\u0646."
    messageType: 0
  - sender: noreply@smsaexpress.com
    subject: "\u0634\u062D\u0646\u062A\u0643 \u062C\u0627\u0647\u0632\u0629 \u0644\u0644\u0627\u0633\u062A\u0644\u0627\u0645
      \u0645\u0646 \u0627\u0644\u062E\u0632\u0627\u0646\u0629 \u0627\u0644\u0630\u0643\u064A\u0629"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B\u060C \u0648\u0635\u0644\u062A
      \u0634\u062D\u0646\u062A\u0643 \u0631\u0642\u0645 2938102 \u0625\u0644\u0649
      \u0627\u0644\u062E\u0632\u0627\u0646\u0629 \u0627\u0644\u0630\u0643\u064A\u0629
      \u0628\u0641\u0631\u0639 \u0627\u0644\u0633\u0644\u064A\u0645\u0627\u0646\u064A\u0629.
      \u0631\u0645\u0632 \u0641\u062A\u062D \u0627\u0644\u062E\u0632\u0627\u0646\u0629
      \u0627\u0644\u062E\u0627\u0635 \u0628\u0643 \u0647\u0648: 5542. \u064A\u0631\u062C\u0649
      \u0627\u0644\u0627\u0633\u062A\u0644\u0627\u0645 \u062E\u0644\u0627\u0644 48
      \u0633\u0627\u0639\u0629 \u0644\u0645\u0646\u0639 \u0627\u0644\u0625\u0631\u062C\u0627\u0639."
    isScam: 0
    explanation: "\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u062A\u062D\u062A\u0648\u064A
      \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u062A\u062A\u0628\u0639
      \u062D\u0642\u064A\u0642\u064A\u0629 \u0648\u0645\u0642\u062A\u0631\u0646\u0629
      \u0628\u0646\u0637\u0627\u0642 \u0634\u0631\u0643\u0629 \u0633\u0645\u0633\u0627
      \u0627\u0644\u0631\u0633\u0645\u064A \u0627\u0644\u0622\u0645\u0646."
    messageType: 0
  - sender: shipping@amazon.sa
    subject: "\u062A\u062D\u062F\u064A\u062B \u062D\u0648\u0644 \u0645\u0648\u0639\u062F
      \u062A\u0648\u0635\u064A\u0644 \u0637\u0644\u0628\u0643 \u0645\u0646 \u0623\u0645\u0627\u0632\u0648\u0646"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u0623\u062D\u0645\u062F\u060C
      \u064A\u0633\u0639\u062F\u0646\u0627 \u0625\u0628\u0644\u0627\u063A\u0643 \u0628\u0623\u0646
      \u0633\u0627\u0626\u0642 \u0623\u0645\u0627\u0632\u0648\u0646 \u0641\u064A
      \u0637\u0631\u064A\u0642\u0647 \u0644\u062A\u0633\u0644\u064A\u0645 \u0637\u0644\u0628\u0643
      \u0627\u0644\u064A\u0648\u0645 \u0628\u064A\u0646 \u0627\u0644\u0633\u0627\u0639\u0629
      4 \u0645\u0633\u0627\u0621\u064B \u06488 \u0645\u0633\u0627\u0621\u064B. \u064A\u0645\u0643\u0646\u0643
      \u062A\u062A\u0628\u0639 \u0645\u0648\u0642\u0639 \u0627\u0644\u0633\u0627\u0626\u0642
      \u0639\u0628\u0631 \u062E\u0631\u064A\u0637\u0629 \u0627\u0644\u062A\u0637\u0628\u064A\u0642."
    isScam: 0
    explanation: "\u0628\u0631\u064A\u062F \u062A\u062A\u0628\u0639 \u062F\u0627\u062E\u0644\u064A
      \u0631\u0633\u0645\u064A \u0645\u0646 \u0634\u0631\u0643\u0629 \u0623\u0645\u0627\u0632\u0648\u0646
      \u0627\u0644\u0633\u0639\u0648\u062F\u064A\u0629 \u0648\u0646\u0637\u0627\u0642\u0647\u0627
      \u062D\u0642\u064A\u0642\u064A \u0643\u0644\u064A\u0627\u064B \u0648\u0639\u0646\u0648\u0627\u0646\u0647
      \u0645\u0637\u0627\u0628\u0642 \u0644\u0647\u0648\u064A\u0629 \u0627\u0644\u0634\u0631\u0643\u0629
      \u0648\u0628\u062F\u0648\u0646 \u0631\u0648\u0627\u0628\u0637 \u0645\u0631\u064A\u0628\u0629
      \u062E\u0627\u0631\u062C \u0627\u0644\u0646\u0637\u0627\u0642."
    messageType: 0
  - sender: noreply@zatca.gov.sa
    subject: "\u0625\u0634\u0639\u0627\u0631 \u0628\u0635\u062F\u0648\u0631 \u0627\u0644\u0641\u0627\u062A\u0648\u0631\u0629
      \u0627\u0644\u0645\u0648\u062D\u062F\u0629 \u0644\u0644\u0645\u0643\u0644\u0641\u064A\u0646"
    content: "\u0627\u0644\u0633\u0627\u062F\u0629 \u0627\u0644\u0645\u0643\u0644\u0641\u064A\u0646\u060C
      \u0646\u0641\u064A\u062F\u0643\u0645 \u0628\u0635\u062F\u0648\u0631 \u0627\u0644\u0641\u0627\u062A\u0648\u0631\u0629
      \u0627\u0644\u0636\u0631\u064A\u0628\u064A\u0629 \u0627\u0644\u0645\u0648\u062D\u062F\u0629
      \u0644\u0644\u0641\u062A\u0631\u0629 \u0627\u0644\u062D\u0627\u0644\u064A\u0629.
      \u064A\u0631\u062C\u0649 \u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649
      \u062D\u0633\u0627\u0628\u0643\u0645 \u0639\u0628\u0631 \u0627\u0644\u0628\u0648\u0627\u0628\u0629
      \u0627\u0644\u0631\u0633\u0645\u064A\u0629 \u0644\u0644\u0633\u062F\u0627\u062F
      \u0642\u0628\u0644 \u062A\u0627\u0631\u064A\u062E \u0627\u0644\u0627\u0633\u062A\u062D\u0642\u0627\u0642."
    isScam: 0
    explanation: "\u0628\u0631\u064A\u062F \u0635\u0627\u062F\u0631 \u0645\u0646
      \u062E\u0627\u062F\u0645 \u062D\u0643\u0648\u0645\u064A \u0631\u0633\u0645\u064A
      \u0645\u0648\u062B\u0642 \u0648\u064A\u0646\u062A\u0647\u064A \u0628\u0627\u0644\u0627\u0645\u062A\u062F\u0627\u062F
      \u0627\u0644\u0633\u064A\u0627\u062F\u064A \u0627\u0644\u0645\u0639\u062A\u0645\u062F."
    messageType: 0
  - sender: noreply@fedex.com
    subject: "\u0627\u0643\u062A\u0645\u0644 \u0627\u0644\u062A\u062E\u0644\u064A\u0635
      \u0627\u0644\u062C\u0645\u0631\u0643\u064A \u0644\u0634\u062D\u0646\u062A\u0643"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u064A\u0633\u0639\u062F\u0646\u0627 \u0625\u0628\u0644\u0627\u063A\u0643 \u0628\u0623\u0646
      \u0634\u062D\u0646\u062A\u0643 \u0627\u0644\u0648\u0627\u0631\u062F\u0629 \u0642\u062F
      \u0627\u062C\u062A\u0627\u0632\u062A \u0627\u0644\u062A\u062E\u0644\u064A\u0635
      \u0627\u0644\u062C\u0645\u0631\u0643\u064A \u0627\u0644\u0633\u0639\u0648\u062F\u064A
      \u0628\u0646\u062C\u0627\u062D\u060C \u0648\u0647\u064A \u0627\u0644\u0622\u0646
      \u0645\u0639 \u0627\u0644\u0645\u0646\u062F\u0648\u0628 \u0644\u0644\u062A\u0648\u0635\u064A\u0644."
    isScam: 0
    explanation: "\u0625\u0634\u0639\u0627\u0631 \u0631\u0633\u0645\u064A \u0633\u0644\u064A\u0645
      \u0645\u0646 \u0634\u0631\u0643\u0629 FedEx \u064A\u0624\u0643\u062F \u0627\u0646\u062A\u0647\u0627\u0621
      \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0628\u0646\u062C\u0627\u062D
      \u0648\u0628\u062F\u0648\u0646 \u0645\u0637\u0627\u0644\u0628\u0629 \u0628\u0631\u0648\u0627\u0628\u0637
      \u062F\u0641\u0639 \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A."
    messageType: 0
  - sender: no-reply@moe.gov.sa
    subject: "\u0625\u0634\u0639\u0627\u0631: \u0627\u0639\u062A\u0645\u0627\u062F
      \u0627\u0644\u062E\u0637\u0629 \u0627\u0644\u0632\u0645\u0646\u064A\u0629 \u0644\u0644\u0639\u0627\u0645
      \u0627\u0644\u062F\u0631\u0627\u0633\u064A \u0627\u0644\u062C\u062F\u064A\u062F"
    content: "\u0627\u0644\u0645\u0643\u0631\u0645\u064A\u0646 \u0645\u0646\u0633\u0648\u0628\u064A
      \u0627\u0644\u062A\u0639\u0644\u064A\u0645 \u0648\u0627\u0644\u0637\u0644\u0627\u0628
      \u0648\u0623\u0648\u0644\u064A\u0627\u0621 \u0627\u0644\u0623\u0645\u0648\u0631\u060C
      \u0623\u0635\u062F\u0631\u062A \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062A\u0639\u0644\u064A\u0645
      \u0627\u0644\u062F\u0644\u064A\u0644 \u0627\u0644\u0645\u062D\u062F\u062B \u0644\u0644\u062A\u0642\u0648\u064A\u0645
      \u0627\u0644\u062F\u0631\u0627\u0633\u064A \u0648\u0627\u0644\u062E\u0637\u0629
      \u0627\u0644\u0632\u0645\u0646\u064A\u0629 \u0644\u0644\u0639\u0627\u0645 \u0627\u0644\u062D\u0627\u0644\u064A.
      \u062A\u062C\u062F\u0648\u0646 \u0627\u0644\u062A\u0641\u0627\u0635\u064A\u0644
      \u0628\u0645\u0648\u0642\u0639 \u0627\u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0627\u0644\u0643\u062A\u0631\u0648\u0646\u064A."
    isScam: 0
    explanation: "\u0627\u0644\u0646\u0637\u0627\u0642 \u062D\u0643\u0648\u0645\u064A
      \u0631\u0633\u0645\u064A (.gov.sa) \u0648\u0645\u062D\u062A\u0648\u0649 \u0627\u0644\u0631\u0633\u0627\u0644\u0629
      \u0639\u0627\u0645 \u0648\u062A\u0648\u062C\u064A\u0647\u064A \u062A\u0645\u0627\u0645\u0627\u064B
      \u0644\u0632\u064A\u0627\u0631\u0629 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0631\u0633\u0645\u064A
      \u0645\u0628\u0627\u0634\u0631\u0629."
    messageType: 0
  - sender: no-reply@riyadbank.com
    subject: "\u0643\u0634\u0641 \u0627\u0644\u062D\u0633\u0627\u0628 \u0627\u0644\u0631\u0628\u0639
      \u0633\u0646\u0648\u064A - \u064A\u0648\u0646\u064A\u0648 2026"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u0646\u0641\u064A\u062F\u0643\u0645 \u0628\u0623\u0646 \u0643\u0634\u0641
      \u062D\u0633\u0627\u0628\u0643\u0645 \u0627\u0644\u0645\u0627\u0644\u064A \u0644\u0644\u0641\u062A\u0631\u0629
      \u0627\u0644\u0645\u0627\u0636\u064A\u0629 \u062C\u0627\u0647\u0632 \u0627\u0644\u0622\u0646.
      \u064A\u0645\u0643\u0646\u0643 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u064A\u0647
      \u0628\u0623\u0645\u0627\u0646 \u0639\u0628\u0631 \u062A\u0633\u062C\u064A\u0644
      \u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649 \u062A\u0637\u0628\u064A\u0642
      \u0627\u0644\u0631\u064A\u0627\u0636 \u0623\u0648\u0646\u0644\u0627\u064A\u0646
      \u0627\u0644\u0631\u0633\u0645\u064A \u0623\u0648 \u0632\u064A\u0627\u0631\u0629
      \u0623\u0642\u0631\u0628 \u0641\u0631\u0639."
    isScam: 0
    explanation: "\u0627\u0644\u0645\u0631\u0633\u0644 \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642
      \u0627\u0644\u0631\u0633\u0645\u064A \u0627\u0644\u0645\u0648\u062B\u0642 \u0644\u0644\u0628\u0646\u0643
      \u0648\u0627\u0644\u0645\u062D\u062A\u0648\u0649 \u0625\u0631\u0634\u0627\u062F\u064A
      \u0644\u0627 \u064A\u0637\u0644\u0628 \u0628\u064A\u0627\u0646\u0627\u062A
      \u062D\u0633\u0627\u0633\u0629."
    messageType: 0
  - sender: noreply@gosi.gov.sa
    subject: "\u0625\u0634\u0639\u0627\u0631: \u062A\u0645 \u062A\u0633\u062C\u064A\u0644\u0643
      \u0628\u0646\u062C\u0627\u062D \u0641\u064A \u0645\u0646\u0634\u0623\u0629
      \u062C\u062F\u064A\u062F\u0629"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0645\u0634\u062A\u0631\u0643\u060C
      \u0646\u0641\u064A\u062F\u0643 \u0628\u0623\u0646\u0647 \u062A\u0645 \u062A\u0633\u062C\u064A\u0644\u0643
      \u0628\u0646\u0638\u0627\u0645 \u0627\u0644\u062A\u0623\u0645\u064A\u0646\u0627\u062A
      \u0627\u0644\u0627\u062C\u062A\u0645\u0627\u0639\u064A\u0629 \u0643\u0639\u0627\u0645\u0644
      \u062A\u0627\u0628\u0639 \u0644\u0645\u0646\u0634\u0623\u0629 \u062A\u0643\u0646\u0648\u0644\u0648\u062C\u064A\u0627
      \u0627\u0644\u0645\u0633\u062A\u0642\u0628\u0644 \u0627\u0644\u0645\u062D\u062F\u0648\u062F\u0629
      \u0627\u0639\u062A\u0628\u0627\u0631\u0627 \u0645\u0646 \u062A\u0627\u0631\u064A\u062E
      \u0627\u0644\u064A\u0648\u0645. \u062A\u0645\u0646\u064A\u0627\u062A\u0646\u0627
      \u0644\u0643 \u0628\u0627\u0644\u062A\u0648\u0641\u064A\u0642."
    isScam: 0
    explanation: "\u0631\u0633\u0627\u0644\u0629 \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629
      \u0622\u0644\u064A\u0629 \u0633\u0644\u064A\u0645\u0629 \u0648\u0645\u0648\u062B\u0642\u0629
      \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0645\u0646 \u0627\u0644\u0633\u064A\u0631\u0641\u0631
      \u0627\u0644\u0645\u062E\u0635\u0635 \u0644\u0644\u0645\u0624\u0633\u0633\u0629."
    messageType: 0
  - sender: no-reply@absher.sa
    subject: "\u0625\u0634\u0639\u0627\u0631: \u062A\u0645 \u0625\u0635\u062F\u0627\u0631
      \u062A\u0623\u0634\u064A\u0631\u0629 \u062E\u0631\u0648\u062C \u0648\u0639\u0648\u062F\u0629
      \u0628\u0646\u062C\u0627\u062D"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0645\u0642\u064A\u0645\u060C
      \u0646\u0641\u064A\u062F\u0643\u0645 \u0628\u0623\u0646\u0647 \u062A\u0645
      \u0625\u0635\u062F\u0627\u0631 \u062A\u0623\u0634\u064A\u0631\u0629 \u062E\u0631\u0648\u062C
      \u0648\u0639\u0648\u062F\u0629 \u0644\u0644\u0645\u0643\u0641\u0648\u0644 \u0627\u0644\u062A\u0627\u0628\u0639
      \u0644\u0643\u0645 \u0639\u0628\u0631 \u0645\u0646\u0635\u0629 \u0623\u0628\u0634\u0631.
      \u064A\u0645\u0643\u0646\u0643 \u0627\u0633\u062A\u0639\u0631\u0627\u0636 \u062A\u0641\u0627\u0635\u064A\u0644
      \u0648\u0635\u0644\u0627\u062D\u064A\u0629 \u0627\u0644\u062A\u0623\u0634\u064A\u0631\u0629
      \u0639\u0628\u0631 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0627\u0644\u0631\u0633\u0645\u064A."
    isScam: 0
    explanation: "\u0625\u0634\u0639\u0627\u0631 \u0631\u0633\u0645\u064A \u0645\u0646
      \u0646\u0637\u0627\u0642 \u0623\u0628\u0634\u0631 \u0627\u0644\u062D\u0642\u064A\u0642\u064A
      \u0648\u0627\u0644\u0645\u062D\u0645\u064A \u0628\u0627\u0644\u0643\u0627\u0645\u0644."
    messageType: 0
  - sender: no-reply@aramex.com
    subject: "\u062A\u0645 \u0625\u0635\u062F\u0627\u0631 \u0628\u0648\u0644\u064A\u0635\u0629
      \u0627\u0644\u0634\u062D\u0646 \u0644\u0637\u0644\u0628\u0643 \u0628\u0646\u062C\u0627\u062D"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u0646\u0641\u064A\u062F\u0643 \u0628\u0623\u0646 \u0627\u0644\u0645\u062A\u062C\u0631
      \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A \u0642\u0627\u0645
      \u0628\u0625\u0646\u0634\u0627\u0621 \u0628\u0648\u0644\u064A\u0635\u0629 \u0634\u062D\u0646
      \u0628\u0631\u0642\u0645 9483921. \u064A\u0645\u0643\u0646\u0643 \u062A\u062A\u0628\u0639
      \u0645\u0633\u0627\u0631 \u0627\u0644\u0634\u062D\u0646\u0629 \u062D\u062A\u0649
      \u0648\u0635\u0648\u0644\u0647\u0627 \u0644\u0648\u062C\u0647\u062A\u0643 \u0639\u0628\u0631
      \u062A\u0637\u0628\u064A\u0642 \u0622\u0631\u0627\u0645\u0643\u0633 \u0627\u0644\u0631\u0633\u0645\u064A."
    isScam: 0
    explanation: "\u0628\u0631\u064A\u062F \u062A\u062A\u0628\u0639 \u0627\u0639\u062A\u064A\u0627\u062F\u064A
      \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0631\u0633\u0645\u064A
      \u0644\u0634\u0631\u0643\u0629 \u0622\u0631\u0627\u0645\u0643\u0633."
    messageType: 0
  - sender: support@dhl.com
    subject: "\u0648\u0635\u0644\u062A \u0627\u0644\u0634\u062D\u0646\u0629 \u0625\u0644\u0649
      \u0645\u0631\u0643\u0632 \u0627\u0644\u0641\u0631\u0632 - \u0627\u0644\u0631\u064A\u0627\u0636"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u0648\u0635\u0644\u062A \u0634\u062D\u0646\u062A\u0643 \u0631\u0642\u0645
      883921094 \u0625\u0644\u0649 \u0645\u0631\u0643\u0632\u0646\u0627 \u0627\u0644\u0631\u0626\u064A\u0633\u064A
      \u0641\u064A \u0627\u0644\u0631\u064A\u0627\u0636\u060C \u0648\u062C\u062F\u0648\u0644
      \u062A\u0648\u0635\u064A\u0644\u0647\u0627 \u0625\u0644\u0649 \u0645\u0646\u0632\u0644\u0643
      \u063A\u062F\u0627\u064B. \u0644\u0627 \u064A\u062A\u0637\u0644\u0628 \u0645\u0646\u0643
      \u0623\u064A \u0625\u062C\u0631\u0627\u0621."
    isScam: 0
    explanation: "\u0627\u0644\u0628\u0631\u064A\u062F \u0645\u0646 \u0633\u064A\u0631\u0641\u0631
      DHL \u0627\u0644\u062D\u0642\u064A\u0642\u064A \u0648\u0627\u0644\u0645\u062D\u062A\u0648\u0649
      \u0625\u0639\u0644\u0627\u0645\u064A \u0628\u062D\u062A \u0644\u0627 \u064A\u0637\u0644\u0628
      \u0623\u064A \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0633\u0631\u064A\u0629
      \u0623\u0648 \u062F\u0641\u0639 \u0645\u0627\u0644\u064A \u0637\u0627\u0631\u0626."
    messageType: 0
  - sender: no-reply@shahid.net
    subject: "\u062A\u0645 \u062A\u062C\u062F\u064A\u062F \u0627\u0634\u062A\u0631\u0627\u0643\u0643
      \u0627\u0644\u0633\u0646\u0648\u064A \u0628\u0646\u062C\u0627\u062D - \u0634\u0643\u0631\u0627\u064B
      \u0644\u0643!"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0645\u0634\u062A\u0631\u0643\u060C
      \u064A\u0633\u0639\u062F\u0646\u0627 \u0625\u0628\u0644\u0627\u063A\u0643 \u0628\u0623\u0646\u0647
      \u062A\u0645 \u062A\u062C\u062F\u064A\u062F \u0628\u0627\u0642\u0629 Shahid
      VIP \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0643 \u062A\u0644\u0642\u0627\u0626\u064A\u0627\u064B
      \u0628\u0646\u062C\u0627\u062D. \u062A\u0645 \u0625\u0635\u062F\u0627\u0631
      \u0627\u0644\u0641\u0627\u062A\u0648\u0631\u0629 \u0648\u064A\u0645\u0643\u0646\u0643
      \u0645\u0631\u0627\u062C\u0639\u0629 \u062A\u0641\u0627\u0635\u064A\u0644 \u062D\u0633\u0627\u0628\u0643
      \u0639\u0628\u0631 \u0627\u0644\u062A\u0637\u0628\u064A\u0642."
    isScam: 0
    explanation: "\u0628\u0631\u064A\u062F \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A
      \u062A\u0644\u0642\u0627\u0626\u064A \u0633\u0644\u064A\u0645 \u0635\u0627\u062F\u0631
      \u0645\u0646 \u0646\u0637\u0627\u0642 \u0645\u0646\u0635\u0629 \u0634\u0627\u0647\u062F
      \u0627\u0644\u062A\u0627\u0628\u0639\u0629 \u0644\u0645\u062C\u0645\u0648\u0639\u0629
      MBC."
    messageType: 0
  - sender: no-reply@mail.instagram.com
    subject: "\u0625\u0634\u0639\u0627\u0631 \u0623\u0645\u0646\u064A: \u0637\u0644\u0628
      \u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646 \u0643\u0644\u0645\u0629
      \u0627\u0644\u0645\u0631\u0648\u0631"
    content: "\u062A\u0644\u0642\u064A\u0646\u0627 \u0637\u0644\u0628\u0627\u064B
      \u0644\u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646 \u0643\u0644\u0645\u0629
      \u0645\u0631\u0648\u0631 \u062D\u0633\u0627\u0628 \u0627\u0646\u0633\u062A\u063A\u0631\u0627\u0645
      \u0627\u0644\u062E\u0627\u0635 \u0628\u0643. \u0625\u0630\u0627 \u0643\u0646\u062A
      \u0623\u0646\u062A \u0645\u0646 \u0637\u0644\u0628 \u0630\u0644\u0643\u060C
      \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637
      \u0623\u062F\u0646\u0627\u0647 \u0644\u062A\u0639\u064A\u064A\u0646 \u0643\u0644\u0645\u0629
      \u0645\u0631\u0648\u0631 \u062C\u062F\u064A\u062F\u0629. \u0625\u0630\u0627
      \u0644\u0645 \u062A\u0637\u0644\u0628 \u0630\u0644\u0643\u060C \u064A\u0645\u0643\u0646\u0643
      \u062A\u062C\u0627\u0647\u0644 \u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u064A\u062F."
    isScam: 0
    explanation: "\u0628\u0631\u064A\u062F \u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646
      \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u0635\u0627\u062F\u0631
      \u0645\u0628\u0627\u0634\u0631\u0629 \u0645\u0646 \u0627\u0644\u062E\u0627\u062F\u0645
      \u0627\u0644\u0645\u0648\u062B\u0642 \u0627\u0644\u062A\u0627\u0628\u0639 \u0644\u0634\u0631\u0643\u0629
      \u0627\u0646\u0633\u062A\u063A\u0631\u0627\u0645 \u0631\u0633\u0645\u064A\u0627\u064B."
    messageType: 0
  - sender: alerts@alinma.com
    subject: "\u062A\u0646\u0628\u064A\u0647: \u062A\u0633\u062C\u064A\u0644 \u062F\u062E\u0648\u0644
      \u062C\u062F\u064A\u062F \u0625\u0644\u0649 \u0625\u0646\u0645\u0627\u0621
      \u0623\u0648\u0646\u0644\u0627\u064A\u0646"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u062A\u0645 \u062A\u0633\u062C\u064A\u0644 \u062F\u062E\u0648\u0644 \u062C\u062F\u064A\u062F
      \u0644\u062D\u0633\u0627\u0628\u0643 \u0628\u062A\u0627\u0631\u064A\u062E \u0627\u0644\u064A\u0648\u0645
      \u0627\u0644\u0633\u0627\u0639\u0629 14:22 \u0639\u0628\u0631 \u0645\u062A\u0635\u0641\u062D
      Safari. \u0625\u0630\u0627 \u0644\u0645 \u062A\u0643\u0646 \u0623\u0646\u062A
      \u0645\u0646 \u0642\u0627\u0645 \u0628\u0647\u0630\u0627 \u0627\u0644\u0625\u062C\u0631\u0627\u0621\u060C
      \u064A\u0631\u062C\u0649 \u0625\u064A\u0642\u0627\u0641 \u0627\u0644\u062E\u062F\u0645\u0629
      \u0641\u0648\u0631\u0627\u064B \u0639\u0628\u0631 \u0627\u0644\u062A\u0637\u0628\u064A\u0642
      \u0623\u0648 \u0627\u0644\u0627\u062A\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645
      \u0627\u0644\u0645\u0648\u062D\u062F."
    isScam: 0
    explanation: "\u062A\u0646\u0628\u064A\u0647 \u0623\u0645\u0646\u064A \u0627\u0639\u062A\u064A\u0627\u062F\u064A
      \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0631\u0633\u0645\u064A
      \u0644\u0644\u0628\u0646\u0643 \u0648\u064A\u062A\u0636\u0645\u0646 \u0625\u062C\u0631\u0627\u0621\u0627\u062A
      \u062D\u0645\u0627\u064A\u0629 \u0648\u0627\u0636\u062D\u0629 \u062F\u0648\u0646
      \u0631\u0648\u0627\u0628\u0637 \u062E\u0627\u0631\u062C\u064A\u0629 \u0645\u0634\u0628\u0648\u0647\u0629."
    messageType: 0
  - sender: messages-noreply@linkedin.com
    subject: "\u0644\u062F\u064A\u0643 4 \u0637\u0644\u0628\u0627\u062A \u0627\u0631\u062A\u0628\u0627\u0637
      \u062C\u062F\u064A\u062F\u0629 \u0639\u0644\u0649 \u0644\u064A\u0646\u0643\u062F
      \u0625\u0646"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u0633\u0627\u0631\u0629\u060C
      \u0647\u0646\u0627\u0643 \u0623\u0634\u062E\u0627\u0635 \u064A\u0628\u062D\u062B\u0648\u0646
      \u0639\u0646 \u0645\u0647\u0627\u0631\u0627\u062A\u0643! \u0644\u0642\u062F
      \u062A\u0644\u0642\u064A\u062A \u0637\u0644\u0628\u0627\u062A \u0627\u0631\u062A\u0628\u0627\u0637
      \u0645\u0646 \u0645\u0633\u0624\u0648\u0644\u064A \u062A\u0648\u0638\u064A\u0641
      \u0641\u064A \u0634\u0631\u0643\u0627\u062A \u062A\u0642\u0646\u064A\u0629
      \u0643\u0628\u0631\u0649. \u0627\u0633\u062A\u0639\u0631\u0636 \u0645\u0644\u0641\u0627\u062A\u0647\u0645
      \u0627\u0644\u0634\u062E\u0635\u064A\u0629 \u0639\u0628\u0631 \u062A\u0637\u0628\u064A\u0642
      \u0644\u064A\u0646\u0643\u062F \u0625\u0646."
    isScam: 0
    explanation: "\u062A\u0646\u0628\u064A\u0647 \u0634\u0628\u0643\u0629 \u0645\u0647\u0646\u064A\u0629
      \u062D\u0642\u064A\u0642\u064A \u0648\u0635\u0627\u062F\u0631 \u0645\u0646
      \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0648\u062B\u0642 \u0644\u0645\u0646\u0635\u0629
      \u0644\u064A\u0646\u0643\u062F \u0625\u0646 \u0628\u062F\u0648\u0646 \u0623\u064A
      \u0637\u0644\u0628\u0627\u062A \u0644\u0628\u064A\u0627\u0646\u0627\u062A \u062D\u0633\u0627\u0633\u0629."
    messageType: 0
  - sender: info@urpay.com.sa
    subject: "\u062A\u062D\u062F\u064A\u062B \u0634\u0631\u0648\u0637 \u0648\u0623\u062D\u0643\u0627\u0645
      \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u0644\u0645\u062D\u0641\u0638\u0629
      \u0627\u0644\u0631\u0642\u0645\u064A\u0629"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u0646\u0648\u062F \u0625\u062E\u0637\u0627\u0631\u0643 \u0628\u062A\u062D\u062F\u064A\u062B
      \u0627\u062A\u0641\u0627\u0642\u064A\u0629 \u0627\u0644\u0634\u0631\u0648\u0637
      \u0648\u0627\u0644\u0623\u062D\u0643\u0627\u0645 \u0627\u0644\u062E\u0627\u0635\u0629
      \u0628\u062E\u062F\u0645\u0627\u062A urpay \u0627\u0644\u0645\u0627\u0644\u064A\u0629
      \u0644\u0639\u0627\u0645 2026. \u064A\u0645\u0643\u0646\u0643 \u0645\u0631\u0627\u062C\u0639\u0629
      \u0643\u0627\u0645\u0644 \u0627\u0644\u0628\u0646\u0648\u062F \u0639\u0628\u0631
      \u0645\u0648\u0642\u0639\u0646\u0627 \u0627\u0644\u0631\u0633\u0645\u064A."
    isScam: 0
    explanation: "\u0631\u0633\u0627\u0644\u0629 \u0625\u0639\u0644\u0627\u0645\u064A\u0629
      \u0639\u0627\u0645\u0629 \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642
      \u0627\u0644\u0631\u0633\u0645\u064A \u0644\u0644\u0634\u0631\u0643\u0629 \u0644\u0627
      \u062A\u062A\u0636\u0645\u0646 \u062A\u0631\u0647\u064A\u0628\u0627\u064B \u0623\u0648
      \u0631\u0648\u0627\u0628\u0637 \u0644\u062C\u0645\u0639 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A."
    messageType: 0
  - sender: hr@mycompany-internal.com
    subject: "\u062C\u062F\u0648\u0644 \u0627\u0644\u0625\u062C\u0627\u0632\u0627\u062A
      \u0627\u0644\u0631\u0633\u0645\u064A\u0629 \u0627\u0644\u0645\u0639\u062A\u0645\u062F
      \u0648\u062A\u062D\u062F\u064A\u062B\u0627\u062A \u0627\u0644\u062A\u063A\u0637\u064A\u0629
      \u0627\u0644\u0637\u0628\u064A\u0629"
    content: "\u0627\u0644\u0632\u0645\u0644\u0627\u0621 \u0627\u0644\u0643\u0631\u0627\u0645\u060C
      \u062A\u062C\u062F\u0648\u0646 \u0641\u064A \u0627\u0644\u0645\u0631\u0641\u0642
      \u0627\u0644\u062F\u0627\u062E\u0644\u064A \u062A\u0641\u0627\u0635\u064A\u0644
      \u0627\u0644\u0625\u062C\u0627\u0632\u0627\u062A \u0627\u0644\u0631\u0633\u0645\u064A\u0629
      \u0627\u0644\u0642\u0627\u062F\u0645\u0629 \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629
      \u0625\u0644\u0649 \u0627\u0644\u062F\u0644\u064A\u0644 \u0627\u0644\u0645\u062D\u062F\u062B
      \u0644\u0644\u0645\u0633\u062A\u0634\u0641\u064A\u0627\u062A \u0627\u0644\u0645\u0634\u0645\u0648\u0644\u0629
      \u0641\u064A \u0634\u0628\u0643\u0629 \u0627\u0644\u062A\u0623\u0645\u064A\u0646
      \u0627\u0644\u0635\u062D\u064A \u0627\u0644\u062C\u062F\u064A\u062F\u0629 \u0644\u0639\u0627\u0645
      2026."
    isScam: 0
    explanation: "\u0631\u0633\u0627\u0644\u0629 \u0625\u062F\u0627\u0631\u064A\u0629
      \u0631\u0648\u062A\u064A\u0646\u064A\u0629 \u0633\u0644\u064A\u0645\u0629 \u0635\u0627\u062F\u0631\u0629
      \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0628\u0631\u064A\u062F\u064A
      \u0627\u0644\u062E\u0627\u0635 \u0628\u0627\u0644\u0634\u0631\u0643\u0629 \u0648\u0645\u0648\u062C\u0647\u0629
      \u0644\u0644\u0645\u0648\u0638\u0641\u064A\u0646 \u0628\u0634\u0643\u0644 \u0622\u0645\u0646."
    messageType: 0
  - sender: service@paypal.com
    subject: "\u0643\u0634\u0641 \u062D\u0633\u0627\u0628\u0643 \u0627\u0644\u0634\u0647\u0631\u064A
      \u0645\u062A\u0627\u062D \u0627\u0644\u0622\u0646 \u0639\u0628\u0631 PayPal"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B\u060C \u0645\u0644\u062E\u0635\u0643
      \u0627\u0644\u0645\u0627\u0644\u064A \u0644\u0640 PayPal \u0639\u0646 \u0627\u0644\u0634\u0647\u0631
      \u0627\u0644\u0645\u0627\u0636\u064A \u062C\u0627\u0647\u0632. \u0633\u062C\u0644
      \u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649 \u0644\u0648\u062D\u0629
      \u062A\u062D\u0643\u0645 \u062D\u0633\u0627\u0628\u0643 \u0627\u0644\u0622\u0645\u0646\u0629
      \u0644\u0639\u0631\u0636 \u062A\u0641\u0627\u0635\u064A\u0644 \u0645\u0639\u0627\u0645\u0644\u0627\u062A\u0643."
    isScam: 0
    explanation: "\u0627\u0644\u0628\u0631\u064A\u062F \u0645\u0631\u0633\u0644 \u0645\u0646
      \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0631\u0633\u0645\u064A \u0627\u0644\u062D\u0642\u064A\u0642\u064A
      \u0644\u0634\u0631\u0643\u0629 PayPal \u0648\u0627\u0644\u0645\u062D\u062A\u0648\u0649
      \u0622\u0645\u0646 \u0648\u0644\u063A\u062A\u0647 \u0627\u062D\u062A\u0631\u0627\u0641\u064A\u0629."
    messageType: 0
  - sender: no-reply@splonline.com.sa
    subject: "\u062A\u0646\u0628\u064A\u0647: \u0648\u0635\u0648\u0644 \u0634\u062D\u0646\u0629
      \u062C\u062F\u064A\u062F\u0629 \u0625\u0644\u0649 \u0635\u0646\u062F\u0648\u0642
      \u0628\u0631\u064A\u062F\u0643 \u0627\u0644\u0631\u0642\u0645\u064A"
    content: "\u0639\u0645\u064A\u0644\u0646\u0627 \u0627\u0644\u0639\u0632\u064A\u0632\u060C
      \u0646\u0641\u064A\u062F\u0643 \u0628\u0648\u0635\u0648\u0644 \u0645\u0648\u0627\u062F
      \u0628\u0631\u064A\u062F\u064A\u0629 \u062C\u062F\u064A\u062F\u0629 \u0625\u0644\u0649
      \u0639\u0646\u0648\u0627\u0646\u0643 \u0627\u0644\u0645\u0648\u062B\u0642.
      \u064A\u0645\u0643\u0646\u0643 \u0627\u0633\u062A\u0644\u0627\u0645 \u0627\u0644\u0634\u062D\u0646\u0629
      \u0623\u0648 \u0637\u0644\u0628 \u062E\u062F\u0645\u0629 \u0627\u0644\u062A\u0648\u0635\u064A\u0644
      \u0644\u0644\u0645\u0646\u0632\u0644 \u0639\u0628\u0631 \u062A\u0637\u0628\u064A\u0642
      \u0633\u0628\u0644 \u0627\u0644\u0631\u0642\u0645\u064A."
    isScam: 0
    explanation: "\u0628\u0631\u064A\u062F \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A
      \u0631\u0633\u0645\u064A \u064A\u062D\u0645\u0644 \u0627\u0644\u0647\u0648\u064A\u0629
      \u0648\u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u062D\u0642\u064A\u0642\u064A
      \u0644\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0628\u0631\u064A\u062F \u0627\u0644\u0633\u0639\u0648\u062F\u064A
      \u0627\u0644\u0645\u0639\u062A\u0645\u062F\u0629."
    messageType: 0
  - sender: no-reply@netflix.com
    subject: "\u062A\u0645\u062A \u0625\u0636\u0627\u0641\u0629 \u0628\u0631\u0627\u0645\u062C
      \u0648\u0623\u0641\u0644\u0627\u0645 \u062C\u062F\u064A\u062F\u0629 \u0647\u0630\u0627
      \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0639\u0644\u0649 Netflix!"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u0628\u0643\u060C \u0644\u0642\u062F
      \u0642\u0645\u0646\u0627 \u0628\u062A\u062E\u0635\u064A\u0635 \u0642\u0627\u0626\u0645\u0629
      \u0628\u0627\u0644\u0623\u0641\u0644\u0627\u0645 \u0627\u0644\u0635\u0627\u062F\u0631\u0629
      \u062D\u062F\u064A\u062B\u0627\u064B \u0648\u0627\u0644\u0645\u0633\u0644\u0633\u0644\u0627\u062A
      \u0627\u0644\u062D\u0635\u0631\u064A\u0629 \u0628\u0646\u0627\u0621\u064B \u0639\u0644\u0649
      \u062A\u0627\u0631\u064A\u062E \u0645\u0634\u0627\u0647\u062F\u062A\u0643.
      \u0627\u0641\u062A\u062D Netflix \u0639\u0644\u0649 \u062A\u0644\u0641\u0627\u0632\u0643
      \u0623\u0648 \u0647\u0627\u062A\u0641\u0643 \u0627\u0644\u0630\u0643\u064A
      \u0644\u0644\u0627\u0633\u062A\u0645\u062A\u0627\u0639 \u0628\u0647\u0627 \u0627\u0644\u0622\u0646."
    isScam: 0
    explanation: "\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0625\u0639\u0644\u0627\u0646\u064A\u0629
      \u0648\u062A\u0633\u0648\u064A\u0642\u064A\u0629 \u0631\u0648\u062A\u064A\u0646\u064A\u0629
      \u0645\u0631\u0633\u0644\u0629 \u0645\u0646 \u062E\u0627\u062F\u0645 \u0646\u062A\u0641\u0644\u064A\u0643\u0633
      \u0627\u0644\u0631\u0633\u0645\u064A \u0648\u0628\u062F\u0648\u0646 \u0631\u0648\u0627\u0628\u0637
      \u0645\u0631\u064A\u0628\u0629 \u0644\u0637\u0644\u0628 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
      \u0627\u0644\u062F\u0641\u0639\u064A\u0629."
    messageType: 0
  - sender: no-reply@spotify.com
    subject: "\u0642\u0627\u0626\u0645\u0629 \u062A\u0634\u063A\u064A\u0644 Discover
      Weekly \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0643 \u062C\u0627\u0647\u0632\u0629
      \u0639\u0644\u0649 Spotify"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B! \u0644\u0642\u062F \u0642\u0645\u0646\u0627
      \u0628\u062A\u062D\u062F\u064A\u062B \u0642\u0627\u0626\u0645\u0629 \u062A\u0634\u063A\u064A\u0644\u0643
      \u0627\u0644\u0645\u062E\u0635\u0635\u0629 \u0628\u0640 30 \u0623\u063A\u0646\u064A\u0629
      \u062C\u062F\u064A\u062F\u0629 \u0646\u0639\u062A\u0642\u062F \u0623\u0646\u0643
      \u0633\u062A\u062D\u0628\u0647\u0627 \u0628\u0646\u0627\u0621\u064B \u0639\u0644\u0649
      \u0639\u0627\u062F\u0627\u062A\u0643 \u0641\u064A \u0627\u0644\u0627\u0633\u062A\u0645\u0627\u0639.
      \u062A\u0648\u062C\u0647 \u0625\u0644\u0649 Spotify \u0644\u0644\u0627\u0633\u062A\u0645\u0627\u0639
      \u0625\u0644\u064A\u0647\u0627."
    isScam: 0
    explanation: "\u0627\u0644\u0646\u0637\u0627\u0642 \u062D\u0642\u064A\u0642\u064A
      \u0648\u062A\u0641\u0627\u0639\u0644\u064A \u0644\u0634\u0631\u0643\u0629 \u0633\u0628\u0648\u062A\u064A\u0641\u0627\u064A
      \u0648\u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u062E\u0627\u0644\u064A\u0629
      \u062A\u0645\u0627\u0645\u0627\u064B \u0645\u0646 \u0623\u064A \u0637\u0627\u0628\u0639
      \u062A\u0647\u062F\u064A\u062F\u064A \u0623\u0648 \u0645\u0627\u0644\u064A."
    messageType: 0
  - sender: noreply@ea.com
    subject: "\u0631\u0645\u0632 \u0627\u0644\u0623\u0645\u0627\u0646 \u0627\u0644\u062E\u0627\u0635
      \u0628\u062D\u0633\u0627\u0628 EA \u0627\u0644\u062E\u0627\u0635 \u0628\u0643"
    content: "\u0631\u0645\u0632 \u0627\u0644\u062A\u062D\u0642\u0642 \u0644\u062A\u0633\u062C\u064A\u0644
      \u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649 \u062D\u0633\u0627\u0628
      Electronic Arts \u0627\u0644\u062E\u0627\u0635 \u0628\u0643 \u0647\u0648: 483921.
      \u0644\u0627 \u062A\u0634\u0627\u0631\u0643 \u0647\u0630\u0627 \u0627\u0644\u0631\u0645\u0632
      \u0645\u0639 \u0623\u064A \u0634\u062E\u0635\u060C \u0628\u0645\u0627 \u0641\u064A
      \u0630\u0644\u0643 \u0648\u0643\u0644\u0627\u0621 \u062F\u0639\u0645 \u0639\u0645\u0644\u0627\u0621
      EA. \u0627\u0644\u0631\u0645\u0632 \u0635\u0627\u0644\u062D \u0644\u0645\u062F\u0629
      10 \u062F\u0642\u0627\u0626\u0642."
    isScam: 0
    explanation: "\u0631\u0645\u0632 \u062A\u062D\u0642\u0642 \u0623\u0645\u0646\u064A
      \u062D\u0642\u064A\u0642\u064A \u0645\u0631\u0633\u0644 \u0628\u0646\u0627\u0621\u064B
      \u0639\u0644\u0649 \u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645
      \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0631\u0633\u0645\u064A
      \u0644\u0634\u0631\u0643\u0629 EA \u0644\u0644\u0623\u0644\u0639\u0627\u0628
      \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629."
    messageType: 0
  - sender: no-reply@noon.com
    subject: "\u062A\u0645 \u062A\u0648\u0635\u064A\u0644 \u0637\u0644\u0628\u0643
      \u0645\u0646 \u0646\u0648\u0646!"
    content: "\u0645\u0631\u062D\u0628\u0627\u064B \u0628\u0643\u060C \u064A\u0633\u0639\u062F\u0646\u0627
      \u0623\u0646 \u0634\u062D\u0646\u062A\u0643 \u0642\u062F \u0648\u0635\u0644\u062A
      \u0625\u0644\u064A\u0643 \u0627\u0644\u064A\u0648\u0645. \u0646\u0648\u062F
      \u0645\u0639\u0631\u0641\u0629 \u062A\u0642\u064A\u064A\u0645\u0643 \u0644\u062E\u062F\u0645\u0629
      \u0627\u0644\u062A\u0648\u0635\u064A\u0644 \u0648\u062C\u0648\u062F\u0629 \u0627\u0644\u0645\u0646\u062A\u062C\u0627\u062A
      \u0644\u0645\u0633\u0627\u0639\u062F\u062A\u0646\u0627 \u0641\u064A \u062A\u062D\u0633\u064A\u0646
      \u062A\u062C\u0631\u0628\u062A\u0643 \u0627\u0644\u0642\u0627\u062F\u0645\u0629
      \u0639\u0628\u0631 \u062A\u0637\u0628\u064A\u0642 \u0646\u0648\u0646."
    isScam: 0
    explanation: "\u0627\u0633\u062A\u0628\u064A\u0627\u0646 \u0631\u0636\u0627 \u0627\u0644\u0639\u0645\u0644\u0627\u0621
      \u062F\u0648\u0631\u064A \u0648\u0633\u0644\u064A\u0645 \u0648\u0635\u0627\u062F\u0631
      \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0631\u0633\u0645\u064A
      \u0627\u0644\u062D\u0642\u064A\u0642\u064A \u0644\u062E\u062F\u0645\u0629 \u0639\u0645\u0644\u0627\u0621
      \u0646\u0648\u0646 \u0627\u0644\u0645\u0639\u062A\u0645\u062F\u0629."
    messageType: 0
  - sender: noreply@stcpay.com.sa
    subject: "\u062A\u0645 \u062A\u062D\u062F\u064A\u062B \u062D\u062F \u0627\u0644\u062A\u062D\u0648\u064A\u0644
      \u0627\u0644\u064A\u0648\u0645\u064A \u0644\u0645\u062D\u0641\u0638\u062A\u0643
      \u0628\u0646\u062C\u0627\u062D"
    content: "\u0639\u0632\u064A\u0632\u064A \u0627\u0644\u0639\u0645\u064A\u0644\u060C
      \u0646\u0641\u064A\u062F\u0643 \u0628\u0623\u0646\u0647 \u062A\u0645 \u062A\u0639\u062F\u064A\u0644
      \u062D\u062F \u0627\u0644\u062A\u062D\u0648\u064A\u0644 \u0627\u0644\u064A\u0648\u0645\u064A
      \u0627\u0644\u062E\u0627\u0635 \u0628\u062D\u0633\u0627\u0628\u0643 \u0628\u0646\u0627\u0621\u064B
      \u0639\u0644\u0649 \u0637\u0644\u0628\u0643 \u0639\u0628\u0631 \u0627\u0644\u062A\u0637\u0628\u064A\u0642.
      \u0625\u0630\u0627 \u0644\u0645 \u062A\u0642\u0645 \u0628\u0647\u0630\u0627
      \u0627\u0644\u062A\u0639\u062F\u064A\u0644 \u064A\u0631\u062C\u0649 \u0627\u0644\u062A\u0648\u0627\u0635\u0644
      \u0645\u0639 \u0627\u0644\u062F\u0639\u0645 \u0627\u0644\u0641\u0646\u064A
      \u0641\u0648\u0631\u0627\u064B."
    isScam: 0
    explanation: "\u0625\u0634\u0639\u0627\u0631 \u062A\u0623\u0643\u064A\u062F\u064A
      \u0645\u0646 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0631\u0633\u0645\u064A
      \u0648\u0644\u0627 \u064A\u062D\u062A\u0648\u064A \u0639\u0644\u0649 \u0637\u0644\u0628\u0627\u062A
      \u0625\u062F\u062E\u0627\u0644 \u0628\u064A\u0627\u0646\u0627\u062A \u0633\u0631\u064A\u0629."
    messageType: 0
